<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!--If you are willing to use Windows/MacOS native APIs you will need to create 3 projects.
    One for Windows with net7.0-windows TFM, one for MacOS with net7.0-macos and one with net7.0 TFM for Linux.-->
    <TargetFramework>net9.0</TargetFramework>
    <!-- Version deliberately not set here: it comes from Directory.Build.props, which
         is the single source of truth. A local value overrode it, and because this is
         the entry assembly it is what Assembly.GetEntryAssembly() reports - so the
         update check was comparing a stale 1.0.0 against the latest release tag. -->
    <Nullable>enable</Nullable>
    <!-- .NET on Linux refuses to start without ICU unless this is set, and a
         Raspberry Pi OS Lite image does not ship libicu: the app exits before the
         first frame with "Couldn't find a valid ICU package installed on the
         system". Setting it here removes the dependency outright rather than
         making every deployment target carry a ~35 MB library it has no other
         use for.

         Safe because the app is already invariant by construction - Main forces
         InvariantCulture on every thread before Avalonia starts, since grblHAL
         only ever speaks dot-decimal. Nothing in the app constructs a named
         CultureInfo; only the tests do, which is why this lives in the entry
         project rather than Directory.Build.props - CultureRegressionTests has
         to be able to force de-DE to prove the parsing holds under it.

         To back it out: delete this line and add libicu to the .deb's Depends
         in installer/linux/build-deb.sh. -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\icons\GHalSender.ico</ApplicationIcon>
    <BaseOutputPath>..\stage</BaseOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="12.1.2" />
    <PackageReference Include="HarfBuzzSharp" Version="8.3.1.3" />
    <PackageReference Include="HarfBuzzSharp.NativeAssets.macOS" Version="8.3.1.3" />
    <PackageReference Include="HarfBuzzSharp.NativeAssets.WebAssembly" Version="8.3.1.3" />
    <PackageReference Include="HarfBuzzSharp.NativeAssets.Win32" Version="8.3.1.3" />
    <PackageReference Include="Material.Icons.Avalonia" Version="3.0.2" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="3.119.4" ExcludeAssets="All" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="3.119.4" />
    <PackageReference Include="Avalonia.Themes.Simple" Version="12.1.2" />
    <PackageReference Include="ReactiveUI.Avalonia" Version="12.1.1" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
    <PackageReference Include="System.Net.Http" Version="4.3.4" />
    <PackageReference Include="System.Text.RegularExpressions" Version="4.3.1" />
    <PackageReference Include="Xaml.Behaviors.Avalonia" Version="12.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GrbLHALSender\GrbLHALSender.csproj" />
  </ItemGroup>
</Project>
