{
    "GeneralSettings": {
        "NetProjectPath": "GrbLHALSender.Desktop.csproj",
        "ApplicationName": "GrbLHALSender",
        "Version": "1.0.0",
        "PackageName": {
            "$type": "msbuild",
            "property": "AssemblyName"
        },
        "AssemblyName": {
            "$type": "msbuild",
            "property": "AssemblyName"
        }
    },
    "LinuxSettings": {
        "CreateBinSymlink": "True"
    },
    "Win32Settings": {
        "InstallerIcon": "../GrbLHALSender/Assets/GHalSender.ico",
        "Company": "Jay_tech",
        "InstallerRequiresAdmin": "False",
        "IncludeUninstaller": "True"
    },
    "MacOsSettings": {
        "CreateBundle": true,
        "BundleIdentifier": "com.CompanyName.GrbLHAL-Sender-Desktop",
        "SigningCredentialsType": "AdHoc"
    },
    "PublishSettings": {
        "PublishReadyToRun": "True",
        "ExtraBuildProperties": {}
    }
}