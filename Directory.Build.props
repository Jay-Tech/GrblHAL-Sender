<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <AvaloniaVersion>11.0.9</AvaloniaVersion>

    <!-- Version for local builds. MSBuild derives AssemblyVersion, FileVersion and
         InformationalVersion from this, and the app shows it in the Utility dialog header.

         Release builds do NOT use this value: release.yml takes the version from the
         pushed git tag and passes /p:Version=X.Y.Z, which overrides it. Keep this in
         step with the newest tag anyway — the update check compares the running build's
         version against the latest release tag, so a stale value here makes a local
         build report an update it already has. The release job fails if the two differ.

         To release: bump this, commit, tag the commit v<same number>, push the tag. -->
    <Version>1.0.32</Version>

    <!-- Application metadata -->
    <Product>GrblHAL Sender</Product>
    <Authors>Jay-Tech</Authors>
    <Company>Jay-Tech</Company>
    <Copyright>Copyright (c) Jay-Tech 2025</Copyright>
    <Description>A cross-platform G-code sender for grblHAL CNC controllers</Description>
  </PropertyGroup>
</Project>
