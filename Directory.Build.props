<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <AvaloniaVersion>11.0.9</AvaloniaVersion>

    <!-- Version properties - overridden by CI via /p:Version=X.Y.Z -->
    <Version>0.0.1</Version>
    <AssemblyVersion>0.0.1.0</AssemblyVersion>
    <FileVersion>0.0.1.0</FileVersion>
    <InformationalVersion>0.0.1-dev</InformationalVersion>

    <!-- Application metadata -->
    <Product>GrblHAL Sender</Product>
    <Authors>Jay-Tech</Authors>
    <Company>Jay-Tech</Company>
    <Copyright>Copyright (c) Jay-Tech 2025</Copyright>
    <Description>A cross-platform G-code sender for grblHAL CNC controllers</Description>
  </PropertyGroup>
</Project>
