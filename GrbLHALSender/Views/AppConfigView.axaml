<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:vm="clr-namespace:GrbLHALSender.ViewModels"
			 xmlns:gpio="clr-namespace:GrbLHALSender.Gpio"
			 xmlns:theming="clr-namespace:GrbLHALSender.Theming"
			 xmlns:views="clr-namespace:GrbLHALSender.Views"
			 x:DataType="vm:AppConfigViewModel"
			 mc:Ignorable="d" d:DesignWidth="650" d:DesignHeight="700"
			 x:Class="GrbLHALSender.Views.AppConfigView">

	<Design.DataContext>
		vm:AppConfigViewModel
	</Design.DataContext>
	<UserControl.Styles>
		<Style Selector="Label">
			<Setter Property="FontSize" Value="18"/>
		</Style>
		<Style Selector="CheckBox">
			<Setter Property="FontSize" Value="20"/>
		</Style>
		<Style Selector="TextBox">
			<Setter Property="FontSize" Value="20"/>
		</Style>
	</UserControl.Styles>
	<Grid RowDefinitions="*,Auto">
		<TabControl TabStripPlacement="Top">

			<!-- App Height Tab -->
			<TabItem Header="APP" FontSize="16" Padding="15,5">
				<Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" Margin="10">
					<Grid Grid.Row="0" RowDefinitions="Auto,Auto" ColumnDefinitions="*,*,*,*">
						<CheckBox Grid.Row="0" Grid.Column="0"
								  Content="Full Screen"
								  Margin="20,0,0,0"
								  HorizontalContentAlignment="Center"
								  VerticalContentAlignment="Center"
								  HorizontalAlignment="Left"
								  VerticalAlignment="Top"
								  ToolTip.Tip="Check to enable Borderless Window"
								  IsChecked="{Binding BorderlessWindow}"/>
						<CheckBox Grid.Row="0" Grid.Column="1"
								  Content="OS+App Shut Down"
								  Margin="20,0,0,0"
								  HorizontalContentAlignment="Center"
								  VerticalContentAlignment="Center"
								  HorizontalAlignment="Left"
								  VerticalAlignment="Top"
								  ToolTip.Tip="Check to Shut Down OS on App Close (Linux only)"
								  IsChecked="{Binding ShutDownOs}"/>
						<CheckBox Grid.Row="0" Grid.Column="2"
								  Content="Metric UI "
								  Margin="20,0,0,0"
								  HorizontalContentAlignment="Center"
								  VerticalContentAlignment="Center"
								  HorizontalAlignment="Left"
								  VerticalAlignment="Top"
								  ToolTip.Tip="Check to enable Metric uncheck for imperial"
								  IsChecked="{Binding UseMetric}"/>

						<CheckBox Grid.Row="0" Grid.Column="3"
								  Content="Tool Path Progress"
								  Margin="0,0,0,0"
								  HorizontalContentAlignment="Center"
								  VerticalContentAlignment="Center"
								  HorizontalAlignment="Left"
								  VerticalAlignment="Top"
								  ToolTip.Tip="Show cut progress on the 3D toolpath during job execution. Disable to save resources on lower-power devices."
								  IsChecked="{Binding EnableCutLines}"/>
						<CheckBox Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
								  Content="Stream Buffer Ahead"
								  Margin="20,8,0,0"
								  HorizontalContentAlignment="Center"
								  VerticalContentAlignment="Center"
								  HorizontalAlignment="Left"
								  VerticalAlignment="Top"
								  ToolTip.Tip="On (default): pre-fill grblHAL's RX buffer for maximum throughput. Off: send one gcode line at a time and wait for ack — slower, but the highlighted gcode line tracks the machine position more closely."
								  IsChecked="{Binding StreamBufferAhead}"/>
						<CheckBox Grid.Row="1" Grid.Column="2"
								  Content="Turn On AntiAlias"
								  Margin="20,0,0,0"
								  HorizontalContentAlignment="Center"
								  VerticalContentAlignment="Center"
								  HorizontalAlignment="Left"
								  VerticalAlignment="Top"
								  ToolTip.Tip="Turn off AntiAlias for 3d model. Image quality will decrease to save resources on lower-power devices."
								  IsChecked="{Binding UseAntiAlias}"/>
					</Grid>
					<Grid Grid.Row="1" >
						<StackPanel Orientation="Horizontal"  Spacing="10"
                                    Margin="0,10,0,0"
                                    HorizontalAlignment="Left">
                            <Label 
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                HorizontalContentAlignment="Right"
                                VerticalContentAlignment="Center"
                                FontSize="18"
                                Content="Poll Rate:"/>
                            <TextBox 
                                Width="185"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                HorizontalContentAlignment="Left"
                                VerticalContentAlignment="Center"
                                FontSize="18"
                                ToolTip.Tip="Enter Poll Rate for real time report. Recommend to stay above 100mm"
                                Text="{Binding PollRate}"/>
                            <Label
                                Margin="10,0,0,0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                FontSize="18"
                                Content="Renderer:"/>
                            <ComboBox
                                Width="215"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                FontSize="18"
                                ToolTip.Tip="Software uses SkiaSharp (CPU). Hardware uses OpenGL (GPU). Requires save and takes effect immediately."
                                ItemsSource="{Binding RendererOptions}"
                                SelectedIndex="{Binding RendererIndex}"/>
                        </StackPanel>
                        
					</Grid>
					<Grid Grid.Row="2" 
						  Margin="0,10,0,0">
						<StackPanel Orientation="Horizontal" Spacing="10">
                            
                            <Label Margin="0,0,0,0"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Center"
                                   HorizontalContentAlignment="Right"
                                   VerticalContentAlignment="Center"
                                   FontSize="18"
                                   Content="Spdl Img:"/>
                            <TextBox
                                     Width="185"
                                     HorizontalAlignment="Left"
                                     VerticalAlignment="Center"
                                     HorizontalContentAlignment="Left"
                                     VerticalContentAlignment="Center"
                                     FontSize="18"
                                     ToolTip.Tip="PNG image filename in Config folder (e.g. spindle.png). Leave empty for default procedural drawing."
                                     Text="{Binding SpindleImagePath}"/>
                           
                        </StackPanel>
                       
					</Grid>
					<Grid Grid.Row="3" ColumnDefinitions="*,*"  >
						<Border Grid.Column="0" Padding="5,10"
								Margin="0,10,0,0"
								BorderBrush="AntiqueWhite"
								BorderThickness="1">
							<Grid ColumnDefinitions="Auto,*" RowDefinitions="*,*,*,*">
								<Label Grid.Row="0" Grid.Column="0"  Grid.ColumnSpan="2"
									   Margin="0,0,0,0"
									   Content="METRIC JOG DISTANCE"
									   HorizontalContentAlignment="Center"
									   VerticalContentAlignment="Center"
									   HorizontalAlignment="Center"
									   VerticalAlignment="Center"/>
								<Label Grid.Column="0" Grid.Row="1"
									   HorizontalContentAlignment="Right"
									   VerticalContentAlignment="Center"
									   HorizontalAlignment="Right"
									   VerticalAlignment="Center"
									   Content="FINE:"/>
								<TextBox Grid.Row="1" Grid.Column="1"
										 Width="120"
										 HorizontalAlignment="Left"
										 VerticalAlignment="Center"
										 HorizontalContentAlignment="Left"
										 VerticalContentAlignment="Center"
										 Text="{Binding MetricJogDistance[0]}"/>
								<Label Grid.Row="2" Grid.Column="0"
									   HorizontalContentAlignment="Right"
									   VerticalContentAlignment="Center"
									   HorizontalAlignment="Right"
									   VerticalAlignment="Center"
									   Content="MEDIUM:"/>
								<TextBox Grid.Row="2" Grid.Column="1"
										 Width="120"
										 HorizontalAlignment="Left"
										 VerticalAlignment="Center"
										 HorizontalContentAlignment="Left"
										 VerticalContentAlignment="Center"
										 Text="{Binding MetricJogDistance[1]}"/>
								<Label Grid.Row="3" Grid.Column="0"
									   HorizontalContentAlignment="Right"
									   VerticalContentAlignment="Center"
									   HorizontalAlignment="Right"
									   VerticalAlignment="Center"
									   Content="COURSE:"/>
								<TextBox Grid.Row="3" Grid.Column="1"
										 Width="120"
										 HorizontalAlignment="Left"
										 VerticalAlignment="Center"
										 HorizontalContentAlignment="Left"
										 VerticalContentAlignment="Center"
										 Text="{Binding MetricJogDistance[2]}"/>
							</Grid>
						</Border>

						<Border Grid.Row="0"  Grid.Column="1"
								Margin="0,10,0,0"
								Padding="5,10"
								BorderThickness="1"
								BorderBrush="AntiqueWhite" >
							<Grid ColumnDefinitions="Auto,*" RowDefinitions="*,*,*,*">
								<Label Grid.Row="0" Grid.Column="0"  Grid.ColumnSpan="2"
									   Margin="0,0,0,0"
									   Content="IMPERIAL JOG DISTANCE"
									   HorizontalContentAlignment="Center"
									   VerticalContentAlignment="Center"
									   HorizontalAlignment="Center"
									   VerticalAlignment="Center"/>
								<Label Grid.Column="0" Grid.Row="1"
									   HorizontalContentAlignment="Right"
									   VerticalContentAlignment="Center"
									   HorizontalAlignment="Right"
									   VerticalAlignment="Center"
									   Content="FINE:"/>
								<TextBox Grid.Row="1" Grid.Column="1"
										 Width="120"
										 HorizontalAlignment="Left"
										 VerticalAlignment="Center"
										 HorizontalContentAlignment="Left"
										 VerticalContentAlignment="Center"
										 Text="{Binding ImperialJogDistance[0]}"/>
								<Label Grid.Row="2" Grid.Column="0"
									   HorizontalContentAlignment="Right"
									   VerticalContentAlignment="Center"
									   HorizontalAlignment="Right"
									   VerticalAlignment="Center"
									   Content="MEDIUM:"/>
								<TextBox Grid.Row="2" Grid.Column="1"
										 Width="120"
										 HorizontalAlignment="Left"
										 VerticalAlignment="Center"
										 HorizontalContentAlignment="Left"
										 VerticalContentAlignment="Center"
										 Text="{Binding ImperialJogDistance[1]}"/>
								<Label Grid.Row="3" Grid.Column="0"
									   HorizontalContentAlignment="Right"
									   VerticalContentAlignment="Center"
									   HorizontalAlignment="Right"
									   VerticalAlignment="Center"
									   Content="COURSE:"/>
								<TextBox Grid.Row="3" Grid.Column="1"
										 Width="120"
										 HorizontalAlignment="Left"
										 VerticalAlignment="Center"
										 HorizontalContentAlignment="Left"
										 VerticalContentAlignment="Center"
										 Text="{Binding ImperialJogDistance[2]}"/>
							</Grid>
						</Border>
					</Grid>

					<Grid Grid.Row="5" ColumnDefinitions="*,*"  >
						<Border Grid.Column="0" Padding="5,10"
								Margin="0,10,0,0"
								BorderBrush="AntiqueWhite"
								BorderThickness="1">
							<Grid ColumnDefinitions="Auto,*" RowDefinitions="*,*,*,*">
								<Label Grid.Row="0" Grid.Column="0"  Grid.ColumnSpan="2"
									   Margin="0,0,0,0"
									   Content="METRIC JOG RATE"
									   HorizontalContentAlignment="Center"
									   VerticalContentAlignment="Center"
									   HorizontalAlignment="Center"
									   VerticalAlignment="Center"/>
								<Label Grid.Column="0" Grid.Row="1"
									   HorizontalContentAlignment="Right"
									   VerticalContentAlignment="Center"
									   HorizontalAlignment="Right"
									   VerticalAlignment="Center"
									   Content="SLOW:"/>
								<TextBox Grid.Row="1" Grid.Column="1"
										 Width="120"
										 HorizontalAlignment="Left"
										 VerticalAlignment="Center"
										 HorizontalContentAlignment="Left"
										 VerticalContentAlignment="Center"
										 Text="{Binding Path=MetricJogSpeed[0]}"/>
								<Label Grid.Row="2" Grid.Column="0"
									   HorizontalContentAlignment="Right"
									   VerticalContentAlignment="Center"
									   HorizontalAlignment="Right"
									   VerticalAlignment="Center"
									   Content="MEDIUM:"/>
								<TextBox Grid.Row="2" Grid.Column="1"
										 Width="120"
										 HorizontalAlignment="Left"
										 VerticalAlignment="Center"
										 HorizontalContentAlignment="Left"
										 VerticalContentAlignment="Center"
										 Text="{Binding MetricJogSpeed[1]}"/>
								<Label Grid.Row="3" Grid.Column="0"
									   HorizontalContentAlignment="Right"
									   VerticalContentAlignment="Center"
									   HorizontalAlignment="Right"
									   VerticalAlignment="Center"
									   Content="FAST:"/>
								<TextBox Grid.Row="3" Grid.Column="1"
										 Width="120"
										 HorizontalAlignment="Left"
										 VerticalAlignment="Center"
										 HorizontalContentAlignment="Left"
										 VerticalContentAlignment="Center"
										 Text="{Binding MetricJogSpeed[2]}"/>
							</Grid>
						</Border>

						<Border Grid.Row="0"  Grid.Column="1"
								Margin="0,10,0,0"
								Padding="5,10"
								BorderThickness="1"
								BorderBrush="AntiqueWhite" >
							<Grid ColumnDefinitions="Auto,*" RowDefinitions="*,*,*,*">
								<Label Grid.Row="0" Grid.Column="0"  Grid.ColumnSpan="2"
									   Margin="0,0,0,0"
									   Content="IMPERIAL JOG RATE"
									   HorizontalContentAlignment="Center"
									   VerticalContentAlignment="Center"
									   HorizontalAlignment="Center"
									   VerticalAlignment="Center"/>
								<Label Grid.Column="0" Grid.Row="1"
									   HorizontalContentAlignment="Right"
									   VerticalContentAlignment="Center"
									   HorizontalAlignment="Right"
									   VerticalAlignment="Center"
									   Content="SLOW:"/>
								<TextBox Grid.Row="1" Grid.Column="1"
										 Width="120"
										 HorizontalAlignment="Left"
										 VerticalAlignment="Center"
										 HorizontalContentAlignment="Left"
										 VerticalContentAlignment="Center"
										 Text="{Binding ImperialJogSpeed[0]}"/>
								<Label Grid.Row="2" Grid.Column="0"
									   HorizontalContentAlignment="Right"
									   VerticalContentAlignment="Center"
									   HorizontalAlignment="Right"
									   VerticalAlignment="Center"
									   Content="MEDIUM:"/>
								<TextBox Grid.Row="2" Grid.Column="1"
										 Width="120"
										 HorizontalAlignment="Left"
										 VerticalAlignment="Center"
										 HorizontalContentAlignment="Left"
										 VerticalContentAlignment="Center"
										 Text="{Binding ImperialJogSpeed[1]}"/>
								<Label Grid.Row="3" Grid.Column="0"
									   HorizontalContentAlignment="Right"
									   VerticalContentAlignment="Center"
									   HorizontalAlignment="Right"
									   VerticalAlignment="Center"
									   Content="FAST:"/>
								<TextBox Grid.Row="3" Grid.Column="1"
										 Width="120"
										 HorizontalAlignment="Left"
										 VerticalAlignment="Center"
										 HorizontalContentAlignment="Left"
										 VerticalContentAlignment="Center"
										 Text="{Binding ImperialJogSpeed[2]}"/>
							</Grid>
						</Border>
					</Grid>
				</Grid>

			</TabItem>

			<!-- Theme Tab -->
			<TabItem Header="Theme" FontSize="16" Padding="15,5">
				<ScrollViewer>
					<StackPanel Margin="15" Spacing="14">

						<StackPanel Orientation="Horizontal" Spacing="12">
							<Label Content="Preset:" VerticalAlignment="Center" VerticalContentAlignment="Center"/>
							<ComboBox Width="240"
									  ItemsSource="{Binding ThemePresetList}"
									  SelectedIndex="{Binding ThemePresetIndex}"
									  VerticalAlignment="Center"
									  ToolTip.Tip="Base color scheme. The accent below is applied on top of it.">
								<ComboBox.ItemTemplate>
									<DataTemplate>
										<TextBlock Text="{Binding DisplayName}"/>
									</DataTemplate>
								</ComboBox.ItemTemplate>
							</ComboBox>
						</StackPanel>

						<TextBlock Text="Accent color"
								   FontSize="18"
								   FontWeight="SemiBold"
								   Margin="0,6,0,0"/>
						<TextBlock Classes="muted"
								   FontSize="14"
								   TextWrapping="Wrap"
								   Text="Used for borders, active states, the selected tab and signal indicators. Changes preview immediately; press Save to keep them."/>

						<!-- Swatch grid. Deliberately large targets — this is driven by
						     finger on a shop-floor touchscreen, not a mouse. -->
						<ItemsControl ItemsSource="{Binding AccentSwatches}">
							<ItemsControl.ItemsPanel>
								<ItemsPanelTemplate>
									<WrapPanel Orientation="Horizontal"/>
								</ItemsPanelTemplate>
							</ItemsControl.ItemsPanel>
							<ItemsControl.ItemTemplate>
								<DataTemplate x:DataType="theming:AccentSwatch">
									<!-- The color lives on the Border, not the Button: the Fluent
									     theme repaints a Button's own background on :pointerover
									     and :pressed, which would hide the swatch color exactly
									     when the user taps it (and stick there after a touch). -->
									<Border Width="64" Height="64"
											Margin="4"
											CornerRadius="6"
											BorderThickness="2"
											BorderBrush="{DynamicResource PanelBorderBrush}"
											Background="{Binding Brush}">
										<Button Classes="swatch"
												HorizontalAlignment="Stretch"
												VerticalAlignment="Stretch"
												Background="Transparent"
												BorderThickness="0"
												Padding="0"
												ToolTip.Tip="{Binding Name}"
												CommandParameter="{Binding Hex}"
												Command="{Binding $parent[TabItem].((vm:AppConfigViewModel)DataContext).SelectAccentCommand}"/>
									</Border>
								</DataTemplate>
							</ItemsControl.ItemTemplate>
						</ItemsControl>

						<StackPanel Orientation="Horizontal" Spacing="10">
							<Label Content="Hex:" VerticalAlignment="Center" VerticalContentAlignment="Center"/>
							<TextBox Width="180"
									 Text="{Binding AccentColor, Mode=TwoWay}"
									 Watermark="preset default"
									 VerticalContentAlignment="Center"
									 ToolTip.Tip="Enter #RRGGBB, or leave blank to use the preset's own accent. Double-tap for the on-screen keyboard."/>
							<Border Width="46" Height="34"
									CornerRadius="5"
									BorderThickness="2"
									BorderBrush="{DynamicResource PanelBorderBrush}"
									Background="{DynamicResource AccentBrush}"
									VerticalAlignment="Center"
									ToolTip.Tip="Current accent"/>
							<Button Content="Reset"
									Classes="touch-sm"
									Width="110"
									Command="{Binding ResetAccentCommand}"/>
							<TextBlock Text="Not a valid color"
									   Foreground="{DynamicResource AlertBrush}"
									   FontSize="14"
									   VerticalAlignment="Center"
									   IsVisible="{Binding !IsAccentValid}"/>
						</StackPanel>

						<!-- Live sample so the effect is visible without closing the dialog. -->
						<Border Classes="panel" Padding="14" Margin="0,8,0,0">
							<StackPanel Spacing="10">
								<TextBlock Text="Preview" Classes="sectionTitle" FontSize="15"/>
								<StackPanel Orientation="Horizontal" Spacing="10">
									<Button Content="Normal" Classes="touch-sm" Width="120"/>
									<Button Content="Primary" Classes="touch-sm accent" Width="120"/>
									<Button Content="Alarm" Classes="touch-sm danger" Width="120"/>
									<Border Width="30" Height="30" CornerRadius="30"
											Background="{DynamicResource AlertBrush}"
											VerticalAlignment="Center"
											ToolTip.Tip="Triggered signal LED"/>
								</StackPanel>
								<TextBlock Text="Primary text on a panel surface"
										   Foreground="{DynamicResource TextPrimaryBrush}"
										   FontSize="15"/>
								<TextBlock Text="Muted secondary text" Classes="muted" FontSize="15"/>
							</StackPanel>
						</Border>

					</StackPanel>
				</ScrollViewer>
			</TabItem>

			<TabItem Header="R-ATC" FontSize="16" Padding="15,5">
				<Grid RowDefinitions="Auto, Auto, Auto,Auto,*" ColumnDefinitions="*,*">
					<CheckBox Margin="0,10,0,20" Grid.Column="0" Grid.Row="0" Grid.ColumnSpan="2"
							  HorizontalAlignment="Center"
							  VerticalAlignment="Center"
							  HorizontalContentAlignment="Center"
							  VerticalContentAlignment="Center"
							  Content="Enable Rapid ATC"
							  FontSize="20"
							  IsChecked="{Binding IsAtcEnabled}"/>

					<Label Grid.Row="1" Grid.Column="0"
						   IsEnabled="{Binding IsAtcEnabled}"
						   HorizontalAlignment="Right"
						   VerticalAlignment="Center"
						   HorizontalContentAlignment="Right"
						   VerticalContentAlignment="Center"
						   Margin="0,10,0,0"
						   FontSize="20"
						   Content="Number of Tools:"></Label>
					<TextBox Grid.Row="1" Grid.Column="1"
							 IsEnabled="{Binding IsAtcEnabled}"
							 Width="120"
							 HorizontalAlignment="Left"
							 VerticalAlignment="Center"
							 HorizontalContentAlignment="Left"
							 VerticalContentAlignment="Center"
							 Margin="0,10,0,0"
							 FontSize="20"
							 Text="{Binding AtcToolCount}"/>
					<Label Grid.Row="2" Grid.Column="0"
						   IsEnabled="{Binding IsAtcEnabled}"
						   HorizontalAlignment="Right"
						   VerticalAlignment="Center"
						   HorizontalContentAlignment="Right"
						   VerticalContentAlignment="Center"
						   Margin="0,10,0,0"
						   FontSize="20"
						   Content="TLR Macro:"></Label>
					<TextBox Grid.Row="2" Grid.Column="1"
							 IsEnabled="{Binding IsAtcEnabled}"
							 Width="120"
							 HorizontalAlignment="Left"
							 VerticalAlignment="Center"
							 HorizontalContentAlignment="Left"
							 VerticalContentAlignment="Center"
							 Margin="0,10,0,0"
							 FontSize="20"
							 ToolTip.Tip="Example: P231"
							 Text="{Binding  TlrMacro}"/>

					<Label Grid.Row="3" Grid.Column="0"
						   IsEnabled="{Binding IsAtcEnabled}"
						   HorizontalAlignment="Right"
						   VerticalAlignment="Center"
						   HorizontalContentAlignment="Right"
						   VerticalContentAlignment="Center"
						   FontSize="20"
						   Margin="0,10,0,0"
						   Content="Unload Macro:"></Label>
					<TextBox Grid.Row="3" Grid.Column="1" Width="120"
							 IsEnabled="{Binding IsAtcEnabled}"
							 HorizontalAlignment="Left"
							 VerticalAlignment="Center"
							 HorizontalContentAlignment="Left"
							 VerticalContentAlignment="Center"
							 Margin="0,10,0,0"
							 FontSize="20"
							 ToolTip.Tip="Example: P221"
							 Text="{Binding UnloadMacro}"/>

				</Grid>
			</TabItem>
			<TabItem Header="Game Pad" FontSize="16" Padding="15,5">
				<Grid RowDefinitions="Auto,*" Margin="0,10,0,0">
					<!-- Enable checkbox always visible -->
					<CheckBox Grid.Row="0"
							  Content="Enable Game pad"
							  HorizontalAlignment="Center"
							  VerticalAlignment="Center"
							  HorizontalContentAlignment="Center"
							  VerticalContentAlignment="Center"
							  IsChecked="{Binding IsGamePadEnabled}"/>

					<!-- Sub-tabs for gamepad settings -->
					<TabControl Grid.Row="1" TabStripPlacement="Top"
								IsEnabled="{Binding IsGamePadEnabled}"
								Margin="0,5,0,0">

						<!-- General Settings Sub-Tab -->
						<TabItem Header="General" FontSize="14" Padding="10,3">
							<ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
								<Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto">
									<Label Grid.Row="0" Grid.Column="0"
										   Content="Dead Zone:"
										   FontSize="16"
										   HorizontalAlignment="Right" VerticalAlignment="Center"
										   HorizontalContentAlignment="Right" VerticalContentAlignment="Center"/>
									<TextBox Grid.Row="0" Grid.Column="1"
											 Width="120" Margin="10,2,0,2"
											 FontSize="16"
											 HorizontalAlignment="Left" VerticalAlignment="Center"
											 ToolTip.Tip="Thumbstick dead zone threshold (0-32767)"
											 Text="{Binding GamePadDeadZone}"/>

									<Label Grid.Row="1" Grid.Column="0"
										   Content="Poll Interval (ms):"
										   FontSize="16"
										   HorizontalAlignment="Right" VerticalAlignment="Center"
										   HorizontalContentAlignment="Right" VerticalContentAlignment="Center"/>
									<TextBox Grid.Row="1" Grid.Column="1"
											 Width="120" Margin="10,2,0,2"
											 FontSize="16"
											 HorizontalAlignment="Left" VerticalAlignment="Center"
											 ToolTip.Tip="SDL event poll interval in milliseconds"
											 Text="{Binding GamePadPollIntervalMs}"/>

									<Label Grid.Row="2" Grid.Column="0"
										   Content="Jog Cmd Interval (ms):"
										   FontSize="16"
										   HorizontalAlignment="Right" VerticalAlignment="Center"
										   HorizontalContentAlignment="Right" VerticalContentAlignment="Center"/>
									<TextBox Grid.Row="2" Grid.Column="1"
											 Width="120" Margin="10,2,0,2"
											 FontSize="16"
											 HorizontalAlignment="Left" VerticalAlignment="Center"
											 ToolTip.Tip="Interval between proportional jog commands in milliseconds"
											 Text="{Binding GamePadJogCommandIntervalMs}"/>

									<Label Grid.Row="3" Grid.Column="0"
										   Content="Jog Increment (mm):"
										   FontSize="16"
										   HorizontalAlignment="Right" VerticalAlignment="Center"
										   HorizontalContentAlignment="Right" VerticalContentAlignment="Center"/>
									<TextBox Grid.Row="3" Grid.Column="1"
											 Width="120" Margin="10,2,0,2"
											 FontSize="16"
											 HorizontalAlignment="Left" VerticalAlignment="Center"
											 ToolTip.Tip="Base jog distance (mm) per tick at full stick deflection"
											 Text="{Binding GamePadJogIncrementMm}"/>

									<Label Grid.Row="4" Grid.Column="0"
										   Content="Jog Increment (inch):"
										   FontSize="16"
										   HorizontalAlignment="Right" VerticalAlignment="Center"
										   HorizontalContentAlignment="Right" VerticalContentAlignment="Center"/>
									<TextBox Grid.Row="4" Grid.Column="1"
											 Width="120" Margin="10,2,0,2"
											 FontSize="16"
											 HorizontalAlignment="Left" VerticalAlignment="Center"
											 ToolTip.Tip="Base jog distance (inches) per tick at full stick deflection"
											 Text="{Binding GamePadJogIncrementInch}"/>

									<Label Grid.Row="5" Grid.Column="0"
										   Content="Response Curve:"
										   FontSize="16"
										   HorizontalAlignment="Right" VerticalAlignment="Center"
										   HorizontalContentAlignment="Right" VerticalContentAlignment="Center"/>
									<TextBox Grid.Row="5" Grid.Column="1"
											 Width="120" Margin="10,2,0,2"
											 FontSize="16"
											 HorizontalAlignment="Left" VerticalAlignment="Center"
											 ToolTip.Tip="Response curve exponent (1.0=linear, 2.0=quadratic, higher=finer control)"
											 Text="{Binding GamePadResponseCurveExponent}"/>

									<Label Grid.Row="6" Grid.Column="0"
										   Content="Trigger Threshold:"
										   FontSize="16"
										   HorizontalAlignment="Right" VerticalAlignment="Center"
										   HorizontalContentAlignment="Right" VerticalContentAlignment="Center"/>
									<TextBox Grid.Row="6" Grid.Column="1"
											 Width="120" Margin="10,2,0,2"
											 FontSize="16"
											 HorizontalAlignment="Left" VerticalAlignment="Center"
											 ToolTip.Tip="Threshold for triggers to fire their mapped action (0-32767)"
											 Text="{Binding GamePadTriggerThreshold}"/>
								</Grid>
							</ScrollViewer>
						</TabItem>

						<!-- Button Mappings Sub-Tab -->
						<TabItem Header="Buttons" FontSize="14" Padding="10,3">
							<ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
								<ItemsControl ItemsSource="{Binding GamePadButtonMappings}">
									<ItemsControl.ItemTemplate>
										<DataTemplate>
											<Grid ColumnDefinitions="140,*" Margin="0,2">
												<Label Grid.Column="0"
													   Content="{Binding DisplayName}"
													   FontSize="15"
													   HorizontalAlignment="Right" VerticalAlignment="Center"
													   HorizontalContentAlignment="Right" VerticalContentAlignment="Center"
													   Margin="0,0,8,0"/>
												<ComboBox Grid.Column="1"
														  ItemsSource="{Binding $parent[UserControl].((vm:AppConfigViewModel)DataContext).GamepadActionNames}"
														  SelectedItem="{Binding SelectedAction}"
														  FontSize="14"
														  Width="200"
														  HorizontalAlignment="Left" VerticalAlignment="Center"/>
											</Grid>
										</DataTemplate>
									</ItemsControl.ItemTemplate>
								</ItemsControl>
							</ScrollViewer>
						</TabItem>

						<!-- Axes & Triggers Sub-Tab -->
						<TabItem Header="Axes &amp; Triggers" FontSize="14" Padding="10,3">
							<ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
								<StackPanel Spacing="10">
									<!-- Axis Mappings -->
									<Border BorderBrush="AntiqueWhite" BorderThickness="1" Padding="8,5">
										<StackPanel>
											<Label Content="AXIS MAPPINGS"
												   FontSize="16"
												   HorizontalAlignment="Center" VerticalAlignment="Center"
												   HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
												   Margin="0,0,0,4"/>
											<ItemsControl ItemsSource="{Binding GamePadAxisMappings}">
												<ItemsControl.ItemTemplate>
													<DataTemplate>
														<Grid ColumnDefinitions="120,Auto,Auto" Margin="0,2">
															<Label Grid.Column="0"
																   Content="{Binding DisplayName}"
																   FontSize="15"
																   HorizontalAlignment="Right" VerticalAlignment="Center"
																   HorizontalContentAlignment="Right" VerticalContentAlignment="Center"
																   Margin="0,0,8,0"/>
															<ComboBox Grid.Column="1"
																	  ItemsSource="{Binding $parent[UserControl].((vm:AppConfigViewModel)DataContext).CncAxisOptions}"
																	  SelectedItem="{Binding SelectedCncAxis}"
																	  FontSize="14"
																	  Width="90"
																	  HorizontalAlignment="Left" VerticalAlignment="Center"/>
															<CheckBox Grid.Column="2"
																	  Content="Inverted"
																	  FontSize="14"
																	  IsChecked="{Binding IsInverted}"
																	  Margin="10,0,0,0"
																	  VerticalAlignment="Center"/>
														</Grid>
													</DataTemplate>
												</ItemsControl.ItemTemplate>
											</ItemsControl>
										</StackPanel>
									</Border>

									<!-- Trigger Mappings -->
									<Border BorderBrush="AntiqueWhite" BorderThickness="1" Padding="8,5">
										<StackPanel>
											<Label Content="TRIGGER MAPPINGS"
												   FontSize="16"
												   HorizontalAlignment="Center" VerticalAlignment="Center"
												   HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
												   Margin="0,0,0,4"/>
											<ItemsControl ItemsSource="{Binding GamePadTriggerMappings}">
												<ItemsControl.ItemTemplate>
													<DataTemplate>
														<Grid ColumnDefinitions="140,*" Margin="0,2">
															<Label Grid.Column="0"
																   Content="{Binding DisplayName}"
																   FontSize="15"
																   HorizontalAlignment="Right" VerticalAlignment="Center"
																   HorizontalContentAlignment="Right" VerticalContentAlignment="Center"
																   Margin="0,0,8,0"/>
															<ComboBox Grid.Column="1"
																	  ItemsSource="{Binding $parent[UserControl].((vm:AppConfigViewModel)DataContext).GamepadActionNames}"
																	  SelectedItem="{Binding SelectedAction}"
																	  FontSize="14"
																	  Width="200"
																	  HorizontalAlignment="Left" VerticalAlignment="Center"/>
														</Grid>
													</DataTemplate>
												</ItemsControl.ItemTemplate>
											</ItemsControl>
										</StackPanel>
									</Border>
								</StackPanel>
							</ScrollViewer>
						</TabItem>
					</TabControl>
				</Grid>
			</TabItem>
			<TabItem Header="Web Server" FontSize="16" Padding="15,5">
				<Grid RowDefinitions="Auto,Auto,Auto,Auto" Margin="10,10,10,0">
					<CheckBox Grid.Row="0"
							  Content="Enable Web Server"
							  HorizontalAlignment="Center"
							  VerticalAlignment="Center"
							  HorizontalContentAlignment="Center"
							  VerticalContentAlignment="Center"
							  Margin="0,10,0,10"
							  IsChecked="{Binding IsWebServerEnabled}"/>
					<Grid Grid.Row="1" ColumnDefinitions="Auto,*" Margin="0,10,0,0">
						<Label Grid.Column="0"
							   HorizontalAlignment="Right"
							   VerticalAlignment="Center"
							   HorizontalContentAlignment="Right"
							   VerticalContentAlignment="Center"
							   FontSize="20"
							   Content="Port:"/>
						<TextBox Grid.Column="1"
								 Width="120"
								 HorizontalAlignment="Left"
								 VerticalAlignment="Center"
								 HorizontalContentAlignment="Left"
								 VerticalContentAlignment="Center"
								 Margin="10,0,0,0"
								 FontSize="20"
								 IsEnabled="{Binding IsWebServerEnabled}"
								 Text="{Binding WebServerPort}"/>
					</Grid>
					<!-- The upload path is not guessable: on Linux it resolves inside
					     ~/.config, which file browsers hide, so an uploaded file looked
					     lost. Selectable so it can be copied rather than transcribed. -->
					<StackPanel Grid.Row="2" Margin="0,20,0,0" HorizontalAlignment="Center">
						<TextBlock Text="Uploaded files are saved to:"
								   Foreground="{DynamicResource TextMutedBrush}"
								   FontSize="14"
								   HorizontalAlignment="Center"/>
						<SelectableTextBlock Text="{Binding UploadDirectory}"
											 FontSize="14"
											 TextWrapping="Wrap"
											 HorizontalAlignment="Center"
											 Margin="0,4,0,0"/>
						<TextBlock Text="The file browser opens here."
								   Foreground="{DynamicResource TextMutedBrush}"
								   FontSize="14"
								   HorizontalAlignment="Center"
								   Margin="0,4,0,0"/>
					</StackPanel>
					<TextBlock Grid.Row="3"
							   Text="Changes require app restart. Access from LAN: http://&lt;this-pc-ip&gt;:port"
							   Foreground="{DynamicResource TextMutedBrush}"
							   FontSize="14"
							   TextWrapping="Wrap"
							   HorizontalAlignment="Center"
							   Margin="0,20,0,0"/>
				</Grid>
			</TabItem>
			<TabItem Header="Aux Outputs" FontSize="16" Padding="15,5">
				<Grid RowDefinitions="Auto,*" Margin="10">
					<!-- Add from available presets -->
					<Border Grid.Row="0" BorderBrush="AntiqueWhite" BorderThickness="1" Padding="10" Margin="0,5,0,10">
						<Grid RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,*">
							<Label Grid.Row="0" Grid.ColumnSpan="2"
								   Content="AVAILABLE OUTPUTS"
								   HorizontalContentAlignment="Center"
								   VerticalContentAlignment="Center"
								   HorizontalAlignment="Center"
								   VerticalAlignment="Center"
								   Margin="0,0,0,8"/>
							<Label Grid.Row="1" Grid.Column="0"
								   Content="Select:"
								   HorizontalAlignment="Right" VerticalAlignment="Center"
								   HorizontalContentAlignment="Right" VerticalContentAlignment="Center"/>
							<StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="10,2,0,2">
								<ComboBox ItemsSource="{Binding AuxOutputViewModel.AuxOutputPresets}"
										  SelectedItem="{Binding AuxOutputViewModel.SelectedAuxPreset}"
										  DisplayMemberBinding="{Binding Name}"
										  Width="200"
										  FontSize="16"
										  HorizontalAlignment="Left" VerticalAlignment="Center"
										  ToolTip.Tip="Mist, Flood and discovered Aux Out pins from the controller"/>
								<Button Content="Add"
										FontSize="16"
										Height="35"
										Width="80"
										Margin="10,0,0,0"
										Command="{Binding AuxOutputViewModel.AddPresetCommand}"
										ToolTip.Tip="Add the selected output to the configured list"/>
							</StackPanel>
						</Grid>
					</Border>
					<!-- Current configured outputs list -->
					<Border Grid.Row="1" BorderBrush="AntiqueWhite" BorderThickness="1" Padding="10">
						<Grid RowDefinitions="Auto,Auto,*">
							<Label Grid.Row="0"
								   Content="CONFIGURED OUTPUTS"
								   HorizontalContentAlignment="Center"
								   VerticalContentAlignment="Center"
								   HorizontalAlignment="Center"
								   Margin="0,0,0,5"/>
							<!-- Column headers -->
							<Grid Grid.Row="1" ColumnDefinitions="120,120,120,80,Auto" Margin="0,0,0,3">
								<Label Grid.Column="0" Content="Name" FontSize="14"
									   HorizontalContentAlignment="Left" Foreground="{DynamicResource TextMutedBrush}"/>
								<Label Grid.Column="1" Content="On Cmd" FontSize="14"
									   HorizontalContentAlignment="Left" Foreground="{DynamicResource TextMutedBrush}"/>
								<Label Grid.Column="2" Content="Off Cmd" FontSize="14"
									   HorizontalContentAlignment="Left" Foreground="{DynamicResource TextMutedBrush}"/>
								<Label Grid.Column="3" Content="State" FontSize="14"
									   HorizontalContentAlignment="Left" Foreground="{DynamicResource TextMutedBrush}"/>
							</Grid>
							<ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
								<ItemsControl ItemsSource="{Binding AuxOutputViewModel.AuxOutputItems}">
									<ItemsControl.ItemTemplate>
										<DataTemplate>
											<Grid ColumnDefinitions="120,120,120,80,Auto" Margin="0,3">
												<TextBox Grid.Column="0"
														 Text="{Binding Name}"
														 FontSize="16"
														 VerticalAlignment="Center"
														 HorizontalAlignment="Stretch"
														 ToolTip.Tip="Edit to rename this button"/>
												<Label Grid.Column="1"
													   Content="{Binding OnCommand}"
													   FontSize="14"
													   Foreground="{DynamicResource TextMutedBrush}"
													   VerticalAlignment="Center"
													   HorizontalContentAlignment="Left"/>
												<Label Grid.Column="2"
													   Content="{Binding OffCommand}"
													   FontSize="14"
													   Foreground="{DynamicResource TextMutedBrush}"
													   VerticalAlignment="Center"
													   HorizontalContentAlignment="Left"/>
												<Label Grid.Column="3"
													   Content="{Binding StateKey}"
													   FontSize="14"
													   Foreground="{DynamicResource TextMutedBrush}"
													   VerticalAlignment="Center"
													   HorizontalContentAlignment="Left"/>
												<Button Grid.Column="4"
														Content="Remove"
														FontSize="14"
														Height="30"
														Margin="5,0,0,0"
														VerticalAlignment="Center"
														Command="{Binding $parent[UserControl].((vm:AppConfigViewModel)DataContext).AuxOutputViewModel.RemoveAuxOutputCommand}"
														CommandParameter="{Binding}"/>
											</Grid>
										</DataTemplate>
									</ItemsControl.ItemTemplate>
								</ItemsControl>
							</ScrollViewer>
						</Grid>
					</Border>
				</Grid>
			</TabItem>
			<TabItem Header="GPIO" FontSize="16" Padding="15,5">
				<Grid RowDefinitions="Auto,Auto,*" Margin="10">
					<Border Grid.Row="0" BorderBrush="AntiqueWhite" BorderThickness="1" Padding="10" Margin="0,5,0,10">
						<StackPanel>
							<CheckBox Content="Enable shop outputs"
									  FontSize="16"
									  IsChecked="{Binding GpioOutputViewModel.IsEnabled}"/>
							<StackPanel Orientation="Horizontal" Margin="0,8,0,0">
								<Label Content="Device:" FontSize="14" VerticalAlignment="Center"
									   Foreground="{DynamicResource TextMutedBrush}"/>
								<ComboBox ItemsSource="{Binding GpioOutputViewModel.DeviceTypes}"
										  SelectedItem="{Binding GpioOutputViewModel.Device}"
										  FontSize="14" Width="130" Margin="6,0,0,0"
										  ToolTip.Tip="PiHeader drives the Pi's own 40-pin header. UsbSerial drives a PICOGPIO microcontroller over USB, which works on any host."/>
								<!-- Greyed for the Pi header, which has no port. -->
								<Label Content="Port:" FontSize="14" VerticalAlignment="Center" Margin="14,0,0,0"
									   Foreground="{DynamicResource TextMutedBrush}"/>
								<ComboBox ItemsSource="{Binding GpioOutputViewModel.AvailablePorts}"
										  SelectedItem="{Binding GpioOutputViewModel.PortName}"
										  IsEnabled="{Binding GpioOutputViewModel.NeedsPort}"
										  FontSize="14" Width="160" Margin="6,0,0,0"
										  ToolTip.Tip="Pick the GPIO device's port explicitly. The app never scans — your controller is on one of these ports and must not be written to."/>
								<Button Content="Refresh"
										FontSize="14" Height="30" Margin="6,0,0,0"
										IsEnabled="{Binding GpioOutputViewModel.NeedsPort}"
										Command="{Binding GpioOutputViewModel.RefreshPortsCommand}"/>
								<Button Content="Reconnect"
										FontSize="14" Height="30" Margin="6,0,0,0"
										Command="{Binding GpioOutputViewModel.ReconnectCommand}"
										ToolTip.Tip="Retry the device. Use this if the port was busy when the app started — an IDE holding it is the usual cause — or after unplugging and reconnecting."/>
							</StackPanel>
							<TextBlock Text="{Binding GpioOutputViewModel.StatusText}"
									   Foreground="{DynamicResource TextMutedBrush}"
									   FontSize="14"
									   TextWrapping="Wrap"
									   Margin="0,6,0,0"/>
							<!-- The polarity note is the one thing that bites people: BCM 9-27
							     boot with a pull-down, so an active-high board reads off through
							     boot, startup and after the app exits. Active-low inverts all of
							     that and wants an external pull-up to stay safe. -->
							<TextBlock Text="Pins are BCM numbers (2-27). Prefer active-high relay boards — they stay off while the Pi boots and after the app closes. Not for E-stop or anything safety-related."
									   Foreground="{DynamicResource TextMutedBrush}"
									   FontSize="13"
									   TextWrapping="Wrap"
									   Margin="0,6,0,0"/>
						</StackPanel>
					</Border>
					<Button Grid.Row="1"
							Content="Add Output"
							FontSize="16"
							Height="35"
							Width="120"
							HorizontalAlignment="Left"
							Margin="0,0,0,8"
							Command="{Binding GpioOutputViewModel.AddOutputCommand}"
							ToolTip.Tip="Adds a row using the next unused header pin"/>
					<Border Grid.Row="2" BorderBrush="AntiqueWhite" BorderThickness="1" Padding="10">
						<Grid RowDefinitions="Auto,*">
							<Grid Grid.Row="0" ColumnDefinitions="120,55,80,105,75,75,Auto" Margin="0,0,0,3">
								<Label Grid.Column="0" Content="Name" FontSize="14"
									   HorizontalContentAlignment="Left" Foreground="{DynamicResource TextMutedBrush}"/>
								<Label Grid.Column="1" Content="Pin" FontSize="14"
									   HorizontalContentAlignment="Left" Foreground="{DynamicResource TextMutedBrush}"/>
								<Label Grid.Column="2" Content="Active Hi" FontSize="14"
									   HorizontalContentAlignment="Left" Foreground="{DynamicResource TextMutedBrush}"/>
								<Label Grid.Column="3" Content="Follows" FontSize="14"
									   HorizontalContentAlignment="Left" Foreground="{DynamicResource TextMutedBrush}"/>
								<Label Grid.Column="4" Content="Min RPM" FontSize="14"
									   HorizontalContentAlignment="Left" Foreground="{DynamicResource TextMutedBrush}"/>
								<Label Grid.Column="5" Content="Off Delay" FontSize="14"
									   HorizontalContentAlignment="Left" Foreground="{DynamicResource TextMutedBrush}"/>
							</Grid>
							<ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
								<ItemsControl ItemsSource="{Binding GpioOutputViewModel.EditableOutputs}">
									<ItemsControl.ItemTemplate>
										<DataTemplate x:DataType="gpio:GpioOutputConfig">
											<Grid ColumnDefinitions="120,55,80,105,75,75,Auto" Margin="0,3">
												<TextBox Grid.Column="0"
														 Text="{Binding Name}"
														 FontSize="16"
														 Margin="0,0,4,0"
														 VerticalAlignment="Center"/>
												<TextBox Grid.Column="1"
														 Text="{Binding Pin}"
														 FontSize="16"
														 Margin="0,0,4,0"
														 VerticalAlignment="Center"
														 ToolTip.Tip="BCM pin number, 2-27"/>
												<CheckBox Grid.Column="2"
														  IsChecked="{Binding ActiveHigh}"
														  VerticalAlignment="Center"
														  ToolTip.Tip="Checked: the relay switches on a HIGH pin"/>
												<ComboBox Grid.Column="3"
														  ItemsSource="{Binding $parent[UserControl].((vm:AppConfigViewModel)DataContext).GpioOutputViewModel.FollowSources}"
														  SelectedItem="{Binding Follow}"
														  FontSize="14"
														  Margin="0,0,4,0"
														  VerticalAlignment="Center"
														  HorizontalAlignment="Stretch"
														  ToolTip.Tip="What the Auto mode tracks. Spindle uses the controller's A: field."/>
												<!-- Greyed rather than hidden when it does not apply, matching how
												     the probe panel handles fields a cycle does not read. -->
												<TextBox Grid.Column="4"
														 Text="{Binding MinSpindleRpm}"
														 FontSize="16"
														 Margin="0,0,4,0"
														 VerticalAlignment="Center"
														 IsEnabled="{Binding FollowsSpindle}"
														 ToolTip.Tip="Only used when Follows is Spindle. Spindle speed at or above which this counts as running; 0 means any spindle-on state. Set it above your ATC's tool-change speed so swapping a holder does not trigger the output."/>
												<TextBox Grid.Column="5"
														 Text="{Binding OffDelaySeconds}"
														 FontSize="16"
														 Margin="0,0,4,0"
														 VerticalAlignment="Center"
														 IsEnabled="{Binding HasFollow}"
														 ToolTip.Tip="Only used when Follows is set. Seconds to stay on after the source goes inactive — clears the hose and stops a contactor cycling on every tool change"/>
												<Button Grid.Column="6"
														Content="Remove"
														FontSize="14"
														Height="30"
														Margin="5,0,0,0"
														VerticalAlignment="Center"
														Command="{Binding $parent[UserControl].((vm:AppConfigViewModel)DataContext).GpioOutputViewModel.RemoveOutputCommand}"
														CommandParameter="{Binding}"/>
											</Grid>
										</DataTemplate>
									</ItemsControl.ItemTemplate>
								</ItemsControl>
							</ScrollViewer>
						</Grid>
					</Border>
				</Grid>
			</TabItem>
			<TabItem Header="G-code Events" FontSize="16" Padding="15,5">
				<Grid RowDefinitions="Auto,*" Margin="10">
					<!-- Add a rule from a template -->
					<Border Grid.Row="0" BorderBrush="AntiqueWhite" BorderThickness="1" Padding="10" Margin="0,5,0,10">
						<Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="Auto,*">
							<Label Grid.Row="0" Grid.ColumnSpan="2"
								   Content="EVENT RULES"
								   HorizontalContentAlignment="Center"
								   VerticalContentAlignment="Center"
								   HorizontalAlignment="Center"
								   VerticalAlignment="Center"
								   Margin="0,0,0,8"/>
							<Label Grid.Row="1" Grid.Column="0"
								   Content="Template:"
								   HorizontalAlignment="Right" VerticalAlignment="Center"
								   HorizontalContentAlignment="Right" VerticalContentAlignment="Center"/>
							<StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="10,2,0,2">
								<ComboBox ItemsSource="{Binding GcodeEventViewModel.Presets}"
										  SelectedItem="{Binding GcodeEventViewModel.SelectedPreset}"
										  DisplayMemberBinding="{Binding Name}"
										  Width="275"
										  FontSize="16"
										  HorizontalAlignment="Left" VerticalAlignment="Center"
										  ToolTip.Tip="Starting points — edit the trigger and commands after adding"/>
								<Button Content="Add"
										FontSize="16"
										Height="35"
										Width="80"
										Margin="10,0,0,0"
										Command="{Binding GcodeEventViewModel.AddPresetCommand}"
										ToolTip.Tip="Add a rule based on the selected template"/>
							</StackPanel>
							<TextBlock Grid.Row="2" Grid.ColumnSpan="2"
									   Margin="0,8,0,0"
									   FontSize="13"
									   TextWrapping="Wrap"
									   Foreground="{DynamicResource TextMutedBrush}"
									   Text="Trigger: one or more commands, comma separated (e.g. $H,G28). $-commands match as a prefix, so $H also catches $HX. A single word matches by value, so M6 catches T3M6 but not M61.&#10;Pre/Post: commands to send before / after the trigger, separated by | for more than one. {T} inserts that word's value from the triggering line, {LINE} the whole line."/>
						</Grid>
					</Border>
					<!-- Configured rules -->
					<Border Grid.Row="1" BorderBrush="AntiqueWhite" BorderThickness="1" Padding="10">
						<Grid RowDefinitions="Auto,Auto,*">
							<Label Grid.Row="0"
								   Content="CONFIGURED RULES"
								   HorizontalContentAlignment="Center"
								   VerticalContentAlignment="Center"
								   HorizontalAlignment="Center"
								   Margin="0,0,0,5"/>
							<!-- Column headers — Pre/Post sit on each rule's second line, labelled there -->
							<!-- Last column is the fixed width of the Remove button, so the
							     star-sized Name column measures the same here as in a row -->
							<Grid Grid.Row="1" ColumnDefinitions="45,*,130,55,60,95" Margin="0,0,0,3">
								<Label Grid.Column="0" Content="On" FontSize="14"
									   HorizontalContentAlignment="Left" Foreground="{DynamicResource TextMutedBrush}"/>
								<Label Grid.Column="1" Content="Name" FontSize="14"
									   HorizontalContentAlignment="Left" Foreground="{DynamicResource TextMutedBrush}"/>
								<Label Grid.Column="2" Content="Trigger" FontSize="14"
									   HorizontalContentAlignment="Left" Foreground="{DynamicResource TextMutedBrush}"/>
								<Label Grid.Column="3" Content="Job" FontSize="14"
									   HorizontalContentAlignment="Left" Foreground="{DynamicResource TextMutedBrush}"/>
								<Label Grid.Column="4" Content="MDI" FontSize="14"
									   HorizontalContentAlignment="Left" Foreground="{DynamicResource TextMutedBrush}"/>
							</Grid>
							<ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
								<ItemsControl ItemsSource="{Binding GcodeEventViewModel.Items}">
									<ItemsControl.ItemTemplate>
										<DataTemplate>
											<!-- Two lines per rule: identity and scope on top,
											     the wrapper commands below with room to read them -->
											<Border BorderBrush="{DynamicResource TextMutedBrush}"
													BorderThickness="0,0,0,1"
													Padding="0,4,0,8"
													Margin="0,0,0,4">
												<Grid RowDefinitions="Auto,Auto">
													<Grid Grid.Row="0" ColumnDefinitions="45,*,130,55,60,95">
														<CheckBox Grid.Column="0"
																  IsChecked="{Binding Enabled}"
																  VerticalAlignment="Center"
																  ToolTip.Tip="Uncheck to keep the rule but stop it firing"/>
														<TextBox Grid.Column="1"
																 Text="{Binding Name}"
																 FontSize="16"
																 VerticalAlignment="Center"
																 HorizontalAlignment="Stretch"
																 ToolTip.Tip="Label for this rule — never sent to the controller"/>
														<TextBox Grid.Column="2"
																 Text="{Binding Trigger}"
																 FontSize="16"
																 Margin="6,0,0,0"
																 VerticalAlignment="Center"
																 HorizontalAlignment="Stretch"
																 ToolTip.Tip="Command(s) to watch for, comma separated. Example: $H,G28"/>
														<CheckBox Grid.Column="3"
																  IsChecked="{Binding ApplyToJob}"
																  Margin="12,0,0,0"
																  VerticalAlignment="Center"
																  ToolTip.Tip="Inject while streaming a loaded job file"/>
														<CheckBox Grid.Column="4"
																  IsChecked="{Binding ApplyToManual}"
																  Margin="12,0,0,0"
																  VerticalAlignment="Center"
																  ToolTip.Tip="Inject for MDI, panel buttons, macros and gamepad commands"/>
														<Button Grid.Column="5"
																Content="Remove"
																FontSize="14"
																Height="30"
																Width="90"
																Margin="5,0,0,0"
																HorizontalAlignment="Left"
																VerticalAlignment="Center"
																Command="{Binding $parent[UserControl].((vm:AppConfigViewModel)DataContext).GcodeEventViewModel.RemoveCommand}"
																CommandParameter="{Binding}"/>
													</Grid>
													<!-- Indented to line up under Name, so the checkbox
													     column stays a clear left edge for the list -->
													<Grid Grid.Row="1" ColumnDefinitions="45,Auto,*,Auto,*" Margin="0,5,0,0">
														<Label Grid.Column="1" Content="Pre:" FontSize="14"
															   VerticalAlignment="Center"
															   HorizontalContentAlignment="Left"
															   Foreground="{DynamicResource TextMutedBrush}"/>
														<TextBox Grid.Column="2"
																 Text="{Binding PreCommands}"
																 FontSize="16"
																 Margin="6,0,0,0"
																 VerticalAlignment="Center"
																 HorizontalAlignment="Stretch"
																 ToolTip.Tip="Sent before the trigger, | between commands. Example: M65P0|G4P0.2"/>
														<Label Grid.Column="3" Content="Post:" FontSize="14"
															   Margin="12,0,0,0"
															   VerticalAlignment="Center"
															   HorizontalContentAlignment="Left"
															   Foreground="{DynamicResource TextMutedBrush}"/>
														<TextBox Grid.Column="4"
																 Text="{Binding PostCommands}"
																 FontSize="16"
																 Margin="6,0,0,0"
																 VerticalAlignment="Center"
																 HorizontalAlignment="Stretch"
																 ToolTip.Tip="Sent after the trigger, | between commands. Example: M64P0"/>
													</Grid>
												</Grid>
											</Border>
										</DataTemplate>
									</ItemsControl.ItemTemplate>
								</ItemsControl>
							</ScrollViewer>
						</Grid>
					</Border>
				</Grid>
			</TabItem>
			<TabItem Header="SD Card" x:Name="SdTabItem" FontSize="16" Padding="15,5">
				<views:SdCardView x:Name="SdCardViewControl" />
			</TabItem>
		</TabControl>
		<StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Bottom" Orientation="Horizontal">
			<Button Content="Save"
					FontSize="20"
					Height="55"
					Width="160"
					Margin="10"
					CornerRadius="6"
					HorizontalContentAlignment="Center"
					VerticalContentAlignment="Center"
					IsEnabled="{Binding !#SdTabItem.IsSelected}"
					HorizontalAlignment="Center"
					Command="{Binding SaveConfigCommand }"/>
			<Button Content="Close"
					FontSize="20"
					Height="55"
					Width="160"
					Margin="10"
					CornerRadius="6"
					HorizontalContentAlignment="Center"
					VerticalContentAlignment="Center"
					HorizontalAlignment="Center"
					IsEnabled="{Binding !#SdTabItem.IsSelected}"
					Command="{Binding CloseCommand }"/>
		</StackPanel>
	</Grid>
</UserControl>
