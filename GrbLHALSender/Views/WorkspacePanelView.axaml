<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:GrbLHALSender.ViewModels"
             xmlns:gpio="clr-namespace:GrbLHALSender.Gpio"
             xmlns:views="clr-namespace:GrbLHALSender.Views"
             mc:Ignorable="d"
             d:DesignWidth="1290" d:DesignHeight="1035"
             x:Class="GrbLHALSender.Views.WorkspacePanelView"
             x:DataType="viewModels:MainViewModel">

	<!-- Tabbed work area: 3D render plus job/g-code overlays, GrblHAL settings, reference,
	     and the macro bar that sits alongside the tab strip.
	     Placement and sizing belong to whichever canvas hosts this, not here. -->
	<Grid>
		<TabControl  TabStripPlacement="Top"  >
			<TabItem Padding="8,0"
					 HorizontalContentAlignment="Center"
					 VerticalContentAlignment="Center"
					 FontSize="{DynamicResource BaseFontSize}"
					 x:Name="HomeTab"
					 Header="Home">
				<Grid RowDefinitions="Auto,*,Auto" ColumnDefinitions="Auto,*,Auto" >
					<!-- Render control: created by MainViewModel based on Renderer config setting.
						 Only the selected renderer is instantiated (Software=Skia or Hardware=OpenGL). -->
					<ContentControl Grid.Row="0" Grid.RowSpan="3" Grid.Column="0" Grid.ColumnSpan="3"
									Content="{Binding RenderControl}"
									HorizontalAlignment="Stretch"
									VerticalAlignment="Stretch"
									HorizontalContentAlignment="Stretch"
									VerticalContentAlignment="Stretch"/>
					<Border Grid.Row="0" Grid.ColumnSpan="3" Grid.Column="0"
							HorizontalAlignment="Stretch"
							IsVisible="{Binding #HomeTab.IsSelected}"
							Background="Transparent"
							VerticalAlignment="Stretch">
						<views:JobButtonView DataContext="{Binding JobViewModel}"/>
					</Border>

					<!-- Who is driving. The job buttons centre themselves and leave this
					     corner empty, which is where the eye already goes when a job is
					     loaded. Two separate states, and the difference matters:

					     MPG ACTIVE - a hardware MPG holds the controller's input stream.
					     Every control in this window stops doing anything, so it has to say
					     why rather than just appear broken.

					     PENDANT - the wireless pendant is connected to us. It goes out on
					     this application's own stream, so nothing is taken away and nothing
					     is disabled. Purely "the handheld is live".

					     Both can show at once, and that combination is worth seeing: the
					     wireless pendant's jogs are refused while an MPG holds the stream. -->
					<!-- Deliberately not bordered pills. These sit in a row of real buttons,
					     and a rounded outline with a background is that row's idiom - it read
					     as something to click. A dot and a label is the status-light idiom
					     instead, and matches the state circles already in the header.
					     MPG carries more weight than PENDANT because it is the one that takes
					     the window away from you. -->
					<StackPanel Grid.Row="0" Grid.Column="0"
								HorizontalAlignment="Left"
								VerticalAlignment="Top"
								Orientation="Vertical"
								Spacing="7"
								Margin="16,16,0,0">
						<StackPanel Orientation="Horizontal" Spacing="7"
									IsVisible="{Binding MpgActive}">
							<Border Width="10" Height="10" CornerRadius="5"
									VerticalAlignment="Center"
									Background="{DynamicResource OkBrush}"/>
							<TextBlock Text="MPG ACTIVE"
									   FontWeight="DemiBold"
									   FontSize="{DynamicResource DetailFontSize}"
									   Foreground="{DynamicResource OkBrush}"
									   VerticalAlignment="Center"/>
						</StackPanel>
						<StackPanel Orientation="Horizontal" Spacing="7"
									IsVisible="{Binding PendantConnected}">
							<Border Width="10" Height="10" CornerRadius="5"
									VerticalAlignment="Center"
									Background="{DynamicResource AccentBrush}"/>
							<TextBlock Text="PENDANT"
									   FontSize="{DynamicResource DetailFontSize}"
									   Foreground="{DynamicResource TextMutedBrush}"
									   VerticalAlignment="Center"/>
							<!-- Three copies of the same reading, one per state,
							     rather than a converter or a brush on the view
							     model - neither of which this project has, and
							     one battery indicator is a poor reason to add
							     the first of either. Only one is ever visible:
							     the flags are mutually exclusive. -->
							<TextBlock Text="{Binding PendantBatteryText}"
									   FontSize="{DynamicResource DetailFontSize}"
									   Foreground="{DynamicResource TextMutedBrush}"
									   VerticalAlignment="Center">
								<TextBlock.IsVisible>
									<MultiBinding Converter="{x:Static BoolConverters.And}">
										<Binding Path="PendantBatteryKnown"/>
										<Binding Path="!PendantBatteryLow"/>
										<Binding Path="!PendantBatteryCritical"/>
									</MultiBinding>
								</TextBlock.IsVisible>
							</TextBlock>
							<TextBlock Text="{Binding PendantBatteryText}"
									   FontWeight="DemiBold"
									   FontSize="{DynamicResource DetailFontSize}"
									   Foreground="{DynamicResource WarnBrush}"
									   VerticalAlignment="Center"
									   IsVisible="{Binding PendantBatteryLow}"/>
							<TextBlock Text="{Binding PendantBatteryText}"
									   FontWeight="DemiBold"
									   FontSize="{DynamicResource DetailFontSize}"
									   Foreground="{DynamicResource AlertBrush}"
									   VerticalAlignment="Center"
									   IsVisible="{Binding PendantBatteryCritical}"/>
						</StackPanel>
					</StackPanel>

					<Border Grid.Row="0" Grid.RowSpan="3" Grid.Column="0" Grid.ColumnSpan="3"
							HorizontalAlignment="Right"
							VerticalAlignment="Stretch"
							IsVisible="{Binding JobViewModel.ShowGCodeConsole}">
						<views:GcodeOutputView DataContext="{Binding JobViewModel}" />
					</Border>

					<Border Grid.Row="2" Grid.ColumnSpan="3" Grid.Column="0"
							VerticalAlignment="Bottom"
							HorizontalAlignment="Center">
						<views:DialogButtonView DataContext="{Binding DialogViewModel}" />
					</Border>

					<!-- Bottom-left output stack: Pi GPIO relays on top, controller aux outputs
					     below, separated by a divider. One container so the two clusters flow
					     off each other — an earlier version positioned the GPIO column with a
					     hardcoded left margin, which broke as soon as the aux column changed
					     width or emptied. -->
					<Border Grid.Row="0" Grid.RowSpan="2"  Grid.Column="0"
							VerticalAlignment="Bottom"
							HorizontalAlignment="Left"
							Margin="10,0,0,10">
						<StackPanel Orientation="Vertical" VerticalAlignment="Bottom" HorizontalAlignment="Left">

							<!-- Pi GPIO relays (lights, dust collection). Deliberately NOT gated on
							     Connected: running the vac for cleanup with the machine idle or the
							     controller unplugged is the main reason the manual mode exists. -->
							<ItemsRepeater ItemsSource="{Binding AppConfigViewModel.GpioOutputViewModel.Outputs}"
										   x:Name="GpioOutputRepeater" HorizontalAlignment="Left" VerticalAlignment="Bottom">
								<ItemsRepeater.Layout>
									<UniformGridLayout ItemsJustification="End" Orientation="Vertical"/>
								</ItemsRepeater.Layout>
								<ItemsRepeater.ItemTemplate>
									<DataTemplate x:DataType="gpio:GpioOutput">
										<!-- Ring shows the physical relay state; the label shows the
										     mode. They differ on purpose — an output in Auto reads
										     AUTO whether or not it is currently energised. -->
										<Border Classes="auxRing"
												Classes.active="{Binding IsOn}"
												BorderThickness="2"
												CornerRadius="5"
												Margin="2"
												VerticalAlignment="Bottom"
												HorizontalAlignment="Left">
											<!-- Taller than the 45px the touch class sets, to carry the
											     mode line at full size. A local value beats a setter. -->
											<Button Classes="touch" Width="100" Height="68"
													IsEnabled="{Binding IsPinReady}"
													BorderThickness="0"
													Command="{Binding ToggleCommand}">
												<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
													<TextBlock Text="{Binding Name}"
															   HorizontalAlignment="Center"
															   TextTrimming="CharacterEllipsis"/>
													<TextBlock Text="{Binding ModeLabel}"
															   HorizontalAlignment="Center"
															   FontSize="{DynamicResource SmallFontSize}"
															   Foreground="{DynamicResource TextMutedBrush}"/>
												</StackPanel>
											</Button>
										</Border>
									</DataTemplate>
								</ItemsRepeater.ItemTemplate>
							</ItemsRepeater>

							<!-- Hidden when no GPIO outputs are configured, which is the default —
							     otherwise every install that never touches GPIO gets a stray rule
							     above the aux column. -->
							<!-- TextMutedBrush rather than PanelBorderBrush: the panel border is tuned
							     for edges against a surface fill and all but vanishes here, floating
							     over the dark 3D viewport. -->
							<Border Height="1"
									Margin="6,8,6,10"
									Opacity="0.5"
									Background="{DynamicResource TextMutedBrush}"
									IsVisible="{Binding AppConfigViewModel.GpioOutputViewModel.HasOutputs}"/>

							<!-- Aux outputs are the controller's own, driven by M62/M64 through the
							     stream, so MPG mode silences them like everything else here. The
							     GPIO list below is host-attached and deliberately not gated: staying
							     out of the stream is the whole reason it exists. -->
							<ItemsRepeater ItemsSource="{Binding AppConfigViewModel.AuxOutputViewModel.AuxOutputItems}"
										   IsEnabled="{Binding ControlsEnabled}"
										   x:Name="AuxOutputRepeater" HorizontalAlignment="Left" VerticalAlignment="Bottom">
								<ItemsRepeater.Layout>
									<UniformGridLayout   ItemsJustification="End" Orientation="Vertical"/>
								</ItemsRepeater.Layout>
								<ItemsRepeater.ItemTemplate>
									<DataTemplate>
										<!-- Active-state border lives on a wrapper, not the Button
										     itself: the Fluent theme repaints the Button's own border
										     on :pointerover/:pressed (which stick after touch), hiding
										     the bound state color until focus moved elsewhere. -->
										<Border Classes="auxRing"
												Classes.active="{Binding IsActive}"
												BorderThickness="2"
												CornerRadius="5"
												Margin="2"
												VerticalAlignment="Bottom"
												HorizontalAlignment="Left">
											<Button Classes="touch" Width="100"
													Content="{Binding Name}"
													BorderThickness="0"
													Command="{Binding ToggleCommand}"/>
										</Border>
									</DataTemplate>
								</ItemsRepeater.ItemTemplate>
							</ItemsRepeater>
						</StackPanel>
					</Border>
				</Grid>
			</TabItem>
			<TabItem Padding="8,0"
					 FontWeight="DemiBold"
					 IsEnabled="{Binding ControlsEnabled}"
					 HorizontalContentAlignment="Center"
					 VerticalContentAlignment="Center"
					 FontSize="{DynamicResource BaseFontSize}" x:Name="SettingTab"
					 Header="GrblHAL Settings">
				<views:SettingView HorizontalAlignment="Stretch"
								   DataContext="{Binding SettingsViewModel}"
								   VerticalAlignment="Stretch"></views:SettingView>
			</TabItem>
			<TabItem Padding="8,0"
					 FontWeight="DemiBold"
					 HorizontalContentAlignment="Center"
					 VerticalContentAlignment="Center"
					 FontSize="{DynamicResource BaseFontSize}" x:Name="ReferenceTab"
					 Header="Reference">
				<views:CheatSheetView HorizontalAlignment="Stretch"
									  DataContext="{Binding CheatSheetViewModel}"
									  VerticalAlignment="Stretch"/>
			</TabItem>
		</TabControl>
		<!-- END Tab Control -->

		<!-- START Header Macro Button Control -->
		<Grid x:Name="MacroBarRow" ColumnDefinitions="Auto,*"
			  HorizontalAlignment="Stretch"
			  VerticalAlignment="Top">
			<!-- Spacer tracks the tab strip width so the macro bar starts
			     after the last tab instead of overlapping the headers. It stays here rather
			     than moving into MacroBarView: the width binds to ReferenceTab, which lives
			     in this namescope. -->
			<Border Grid.Column="0" Width="{Binding #ReferenceTab.Bounds.Right}"/>
			<views:MacroBarView Grid.Column="1" />
		</Grid>
		<!--END Header Macro Button Control-->
	</Grid>
</UserControl>
