<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:viewModels="clr-namespace:GrbLHALSender.ViewModels"
			 mc:Ignorable="d" d:DesignWidth="550" d:DesignHeight="550"
			 x:Class="GrbLHALSender.Views.ProbeView"
			 x:DataType="viewModels:ProbeViewModel">

	<Grid RowDefinitions="Auto,Auto,*,Auto,Auto, Auto" Margin="10">

		<!-- Probe Tool Type Selection.
		     Hidden on the Tool Setter tab: probe type, diameter and plate thickness play no
		     part in a tool length measurement — the offset is differential, so thickness
		     cancels, and diameter only matters for edge and centre finding. Hiding it also
		     gives that tab the height it needs. The rate and distance panel below stays,
		     because the tool reference probe really does use those values. -->
		<Border Grid.Row="0" BorderThickness="1" CornerRadius="4" Padding="10,8"
				Margin="0,0,0,0"
				IsVisible="{Binding !#ToolSetterTab.IsSelected}">
			<Grid RowDefinitions="*,*" >
				<Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,Auto">
					<Label  Grid.Column="0"
							Content="Probe Type:"
							FontSize="16"
							VerticalAlignment="Center"
							Margin="0,0,10,0"/>
					<RadioButton  Grid.Column="1"
								  Content="Touch Plate"
								  FontSize="14"
								  GroupName="ProbeToolType"
								  IsChecked="{Binding IsTouchPlate}"
								  Command="{Binding SetToolTypeTouchPlateCommand}"
								  VerticalAlignment="Center"
								  Margin="0,0,15,0"/>
					<RadioButton  Grid.Column="2"
								  Content="3D Probe"
								  FontSize="14"
								  GroupName="ProbeToolType"
								  IsChecked="{Binding !IsTouchPlate}"
								  Command="{Binding SetToolTypeProbe3DCommand}"
								  VerticalAlignment="Center"
								  Margin="0,0,20,0"/>
				</Grid>
				<Grid Grid.Row="1" ColumnDefinitions="Auto,Auto,Auto,Auto">
					<!-- Greyed for a touch plate, which has no stylus radius to compensate. Note it
					     no longer affects a Z probe on either tool type — a ball meets a Z
					     surface under its own centre — so this drives edge compensation on the
					     corner cycle and the size readout on the centre cycles, nothing else. -->
					<Label Grid.Column="0"
						   Content="Diameter:"
						   FontSize="14"
						   HorizontalAlignment="Right"
						   VerticalAlignment="Center"
						   IsEnabled="{Binding !IsTouchPlate}"
						   Margin="10,10,10,0"/>
					<StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
								IsEnabled="{Binding !IsTouchPlate}">
						<TextBox Text="{Binding ProbeDiameterText}"
								 FontSize="14"
								 Width="65"
								 Height="30"
								 VerticalAlignment="Center"
								 HorizontalAlignment="Left"
								 HorizontalContentAlignment="Center"
								 VerticalContentAlignment="Center"
								 Margin="0,10,2,0"/>
						<TextBlock Text="{Binding UnitLabel}"
								   FontSize="13" VerticalAlignment="Center"
								   Opacity="0.6" Margin="0,10,15,0"/>
					</StackPanel>
					<StackPanel Grid.Column="2" Orientation="Horizontal"
								VerticalAlignment="Center"
								HorizontalAlignment="Left"
								IsVisible="{Binding IsTouchPlate}">
						<Label Content="Plate Thickness:"
							   FontSize="14"
							   HorizontalAlignment="Right"
							   HorizontalContentAlignment="Left"
							   VerticalContentAlignment="Center"
							   VerticalAlignment="Center"
							   Margin="0,10,10,0"/>
						<TextBox Text="{Binding TouchPlateThicknessText}"
								 FontSize="14"
								 Width="65"
								 Height="30"
                                 VerticalAlignment="Center"
                                 HorizontalAlignment="Left"
                                 HorizontalContentAlignment="Center"
                                 VerticalContentAlignment="Center"
								 Margin="0,10,2,0"/>
						<TextBlock Text="{Binding UnitLabel}"
								   FontSize="13" VerticalAlignment="Center"
								   Opacity="0.6" Margin="0,10,10,0"/>
					</StackPanel>
				</Grid>
			</Grid>
		</Border>

		<!-- Shared Parameters -->
		<Border Grid.Row="1" BorderThickness="1" CornerRadius="4"
                Padding="10,5"
                Margin="0,0,0,8">
			<Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowDefinitions="*,*">
				<Label Grid.Row="0"
					   Grid.Column="0"
					   Content="Search Rate:"
					   FontSize="13"
					   VerticalAlignment="Center"
					   Margin="0,0,4,0"/>
				<TextBox Grid.Row="0" Grid.Column="1"
						 Text="{Binding SearchRateText}"
						 FontSize="13"
						 Width="65" Height="28"
						 HorizontalContentAlignment="Center"
						 VerticalContentAlignment="Center"
						 Margin="0,0,2,0"/>
				<TextBlock Grid.Row="0" Grid.Column="2"
						   Text="{Binding RateLabel}"
						   FontSize="13" VerticalAlignment="Center"
						   Opacity="0.6" Margin="0,0,10,0"/>
				<Label Grid.Row="0" Grid.Column="3"
					   Content="Latch Rate:" FontSize="13"
					   VerticalAlignment="Center"
					   Margin="0,0,4,0"/>
				<TextBox Grid.Row="0" Grid.Column="4"
						 Text="{Binding LatchRateText}"
						 FontSize="13"
						 Width="65" Height="28"
						 HorizontalContentAlignment="Center"
						 VerticalContentAlignment="Center"
						 Margin="0,0,2,0"/>
				<TextBlock Grid.Row="0" Grid.Column="5"
						   Text="{Binding RateLabel}"
						   FontSize="13" VerticalAlignment="Center"
						   Opacity="0.6" Margin="0,0,10,0"/>
				<Label Grid.Row="1" Grid.Column="0"
					   Content="Distance:"
					   HorizontalAlignment="Right"
					   FontSize="13"
					   VerticalAlignment="Center"
					   Margin="0,10,5,0"/>
				<TextBox Grid.Row="1" Grid.Column="1"
						 Text="{Binding ProbeDistanceText}"
						 FontSize="13"
						 Width="65" Height="28"
						 HorizontalContentAlignment="Center"
						 VerticalContentAlignment="Center"
						 Margin="0,10,2,0"/>
				<TextBlock Grid.Row="1" Grid.Column="2"
						   Text="{Binding UnitLabel}"
						   FontSize="13" VerticalAlignment="Center"
						   Opacity="0.6" Margin="0,10,10,0"/>
				<Label Grid.Row="1" Grid.Column="3"
					   Content="Latch Dist:"
					   FontSize="13"
					   HorizontalAlignment="Right"
					   VerticalAlignment="Center"
					   Margin="0,10,5,0"/>
				<TextBox Grid.Row="1" Grid.Column="4"
						 Text="{Binding LatchDistanceText}"
						 FontSize="13"
						 Width="65" Height="28"
						 Margin="0,10,2,0"
						 HorizontalContentAlignment="Center"
						 VerticalContentAlignment="Center"/>
				<TextBlock Grid.Row="1" Grid.Column="5"
						   Text="{Binding UnitLabel}"
						   FontSize="13" VerticalAlignment="Center"
						   Opacity="0.6" Margin="0,10,10,0"/>
			</Grid>
		</Border>

		<!-- Tab Control for Probe Types -->
		<TabControl Grid.Row="2" TabStripPlacement="Top">

			<!-- Z Height Tab -->
			<TabItem Header="Z Height" FontSize="16" Padding="15,5">
				<Grid RowDefinitions="*,Auto" Margin="10">
					<StackPanel Grid.Row="0" Orientation="Vertical"
								HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="15">
						<TextBlock Text="Position probe above workpiece surface, then press Probe Z."
								   FontSize="14" TextWrapping="Wrap" HorizontalAlignment="Center"
								   Margin="0,0,0,10"/>
						<Button Content="Probe Z" FontSize="20" Height="55" Width="160"
								CornerRadius="6" HorizontalContentAlignment="Center"
								VerticalContentAlignment="Center"
								HorizontalAlignment="Center"
								IsEnabled="{Binding CanStartProbe}"
								Command="{Binding ProbeZCommand}"/>
					</StackPanel>
				</Grid>
			</TabItem>

			<!-- Corner Tab -->
			<TabItem Header="Corner" FontSize="16" Padding="15,5">
				<!-- All three rows size to content. The tab area is as tall as the tallest tab
				     and no taller, so a star row here gets nothing left over and whatever sits
				     in it disappears entirely. -->
				<Grid RowDefinitions="Auto,Auto,Auto" Margin="5" ColumnDefinitions="*,*">

					<!-- Corner Selection. One row of four rather than two by two: the labels are
					     short enough, and the row it saves is what the probe button needs. -->
					<!-- No "Select Corner:" caption: the tab is called Corner and the four buttons
					     name corners. The row it costs is the difference between the probe
					     button being on screen and not. -->
					<StackPanel Grid.Row="0" Grid.ColumnSpan="2" Orientation="Vertical" Margin="0,0,0,5">
						<StackPanel Spacing="8" Orientation="Horizontal" HorizontalAlignment="Center">
                            <RadioButton Content="Front Left" FontSize="14"
                                         GroupName="CornerDir" IsChecked="True" Margin="4,2"
                                         Command="{Binding SetCornerCommand}" CommandParameter="FrontLeft"/>
                            <RadioButton Content="Front Right" FontSize="14"
                                         GroupName="CornerDir" Margin="4,2"
                                         Command="{Binding SetCornerCommand}" CommandParameter="FrontRight"/>
                            <RadioButton Content="Back Left" FontSize="14"
                                         GroupName="CornerDir" Margin="4,2"
                                         Command="{Binding SetCornerCommand}" CommandParameter="BackLeft"/>
							<RadioButton Content="Back Right" FontSize="14"
										 GroupName="CornerDir" Margin="4,2"
										 Command="{Binding SetCornerCommand}" CommandParameter="BackRight"/>
						</StackPanel>
					</StackPanel>

					<!-- Options. Spans both columns and keeps the two heights on one line: the
					     tab sits in a star row inside a fixed-height dialog, so stacking them
					     clipped the bottom of this row and took the probe button with it. -->
					<StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Vertical" Margin="0,0,0,5">
						<CheckBox Content="Include Z Probe" FontSize="14"
								  IsChecked="{Binding IncludeZInCorner}" Margin="0,0,0,5"/>
						<StackPanel Orientation="Horizontal">
							<Label Content="Clearance Height:" FontSize="13" VerticalAlignment="Center" Margin="0,0,5,0"/>
							<TextBox Text="{Binding ClearanceHeightText}" FontSize="13" Width="65" Height="28"
									 HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
									 Margin="0,0,2,0"
									 ToolTip.Tip="Safe height it lifts to before moving, and how far it steps clear of the stock."/>
							<TextBlock Text="{Binding UnitLabel}"
									   FontSize="13" VerticalAlignment="Center"
									   Opacity="0.6" Margin="0,0,15,0"/>

							<!-- How far below the start height the stylus drops to get beside the
							     stock. Distinct from Clearance Height, which is what it lifts to. -->
							<Label Content="Probe Depth:" FontSize="13" VerticalAlignment="Center" Margin="0,0,5,0"/>
							<TextBox Text="{Binding ProbeDepthText}" FontSize="13" Width="65" Height="28"
									 HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
									 Margin="0,0,2,0"
									 ToolTip.Tip="How far below the starting height to drop before probing sideways, so the stylus is beside the stock rather than above it."/>
							<TextBlock Text="{Binding UnitLabel}"
									   FontSize="13" VerticalAlignment="Center"
									   Opacity="0.6"/>
						</StackPanel>
					</StackPanel>

					<!-- Probe Button. Its own Auto row, so it is allocated height rather than
					     handed whatever is left — which was nothing, and hid it completely. -->
					<Button Grid.Row="2" Grid.ColumnSpan="2"
                            Content="Probe Corner"
                            FontSize="18"
							Height="46" Width="160"
                            CornerRadius="6"
							HorizontalAlignment="Center"
                            VerticalAlignment="Top"
							HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
							Margin="0,4,0,0"
							IsEnabled="{Binding CanStartProbe}"
							Command="{Binding ProbeCornerCommand}"/>
				</Grid>
			</TabItem>

			<!-- Center Finder Tab -->
			<TabItem Header="Center Finder" FontSize="16" Padding="15,5">
				<Grid RowDefinitions="Auto,Auto,*" Margin="10" ColumnDefinitions="*,*">

					<!-- Type Selection -->
					<StackPanel Grid.Row="0" Grid.ColumnSpan="2" Orientation="Vertical" Margin="0,0,0,10">
						<Label Content="Feature Type:" FontSize="14" Margin="0,0,0,5"/>
						<StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="15">
							<RadioButton Content="Bore" FontSize="14" GroupName="CenterType" IsChecked="True"
										 Command="{Binding SetCenterTypeCommand}" CommandParameter="Bore"/>
							<RadioButton Content="Rectangle" FontSize="14" GroupName="CenterType"
										 Command="{Binding SetCenterTypeCommand}" CommandParameter="Rectangle"/>
							<RadioButton Content="Boss" FontSize="14" GroupName="CenterType"
										 Command="{Binding SetCenterTypeCommand}" CommandParameter="Boss"/>
						</StackPanel>
					</StackPanel>

					<!-- Parameters. Both only apply to a boss: the inside cycle probes outward
					     until it touches, so it needs no approximate size, and it never moves Z,
					     so it has no use for a clearance height either. -->
					<StackPanel Grid.Row="1" Grid.Column="0" Orientation="Vertical" Spacing="5"
								IsEnabled="{Binding IsBossCenter}">
						<StackPanel Orientation="Horizontal">
							<Label Content="Approx Size:"
                                   FontSize="13"
                                   VerticalAlignment="Center"
                                   Margin="0,0,5,0"/>
							<TextBox Text="{Binding ApproxSizeText}"
                                     FontSize="13"
                                     Width="65"
                                     Height="28"
									 HorizontalContentAlignment="Center"
                                     VerticalContentAlignment="Center"
									 Margin="0,0,2,0"/>
							<TextBlock Text="{Binding UnitLabel}"
									   FontSize="13" VerticalAlignment="Center"
									   Opacity="0.6"/>
						</StackPanel>
						<StackPanel Orientation="Horizontal">
							<Label Content="Clearance Height:"
                                   FontSize="13"
                                   VerticalAlignment="Center"
                                   Margin="0,0,5,0"/>
							<TextBox Text="{Binding ClearanceHeightText}"
                                     FontSize="13" Width="65" Height="28"
									 HorizontalAlignment="Right"
									 HorizontalContentAlignment="Center"
                                     VerticalContentAlignment="Center"
									 Margin="0,0,2,0"/>
							<TextBlock Text="{Binding UnitLabel}"
									   FontSize="13" VerticalAlignment="Center"
									   Opacity="0.6"/>
						</StackPanel>
					</StackPanel>

					<!-- Probe Button -->
					<Button Grid.Row="1" Grid.Column="1" 
                            Content="Find Center"
                            FontSize="18"
							Margin="0,20,0,0"
							Height="50" Width="160" 
                            CornerRadius="6"
							HorizontalAlignment="Center" 
                            VerticalAlignment="Center"
							HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
							IsEnabled="{Binding CanStartProbe}"
							Command="{Binding ProbeCenterCommand}"/>

				</Grid>
			</TabItem>

			<!-- G59.3 is where grblHAL's tool change modes 2 and 3 go to reach the tool
			     setter, and there was previously no way to set it without typing
			     G10 L20 P9 into MDI. -->
			<TabItem Header="Tool Setter" x:Name="ToolSetterTab" FontSize="16" Padding="15,5">
				<!-- Kept short deliberately: the dialog is 480x595 and this tab only gets
				     what is left after the shared parameter panels. The $342 detail lives
				     in the button tooltips. -->
				<Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,*" Margin="8,4">
					<TextBlock Grid.Row="0"
							   Text="G59.3 tool setter position — used by tool change modes 2 and 3."
							   FontSize="13" TextWrapping="Wrap"
							   HorizontalAlignment="Center"
							   Margin="0,0,0,4"/>
					<TextBlock Grid.Row="1"
							   Text="Z position set to safe Z height of longest tool"
							   FontSize="13" TextWrapping="Wrap"
							   HorizontalAlignment="Center"
							   Foreground="{DynamicResource AlertBrush}"
							   Margin="0,0,0,8"/>

					<Border Grid.Row="2" BorderBrush="AntiqueWhite" BorderThickness="1"
							Padding="8,4" Margin="0,0,0,8">
						<Grid ColumnDefinitions="Auto,*">
							<Label Grid.Column="0" Content="G59.3:"
								   FontSize="13"
								   VerticalAlignment="Center"
								   VerticalContentAlignment="Center"
								   Foreground="{DynamicResource TextMutedBrush}"/>
							<TextBlock Grid.Column="1"
									   Text="{Binding ToolSetterPosition}"
									   FontSize="15"
									   TextWrapping="Wrap"
									   VerticalAlignment="Center"
									   HorizontalAlignment="Center"/>
						</Grid>
					</Border>

					<StackPanel Grid.Row="3" Orientation="Horizontal"
								HorizontalAlignment="Center" Spacing="8">
						<Button Content="Read" FontSize="15" Height="40" Width="95"
								CornerRadius="6"
								HorizontalContentAlignment="Center"
								VerticalContentAlignment="Center"
								IsEnabled="{Binding CanStartProbe}"
								Command="{Binding ReadToolSetterCommand}"
								ToolTip.Tip="Read the stored G59.3 offset from the controller"/>
						<Button Content="Set XY Here" FontSize="15" Height="40" Width="135"
								CornerRadius="6"
								HorizontalContentAlignment="Center"
								VerticalContentAlignment="Center"
								IsEnabled="{Binding CanStartProbe}"
								Command="{Binding SetToolSetterXyCommand}"
								ToolTip.Tip="Store the current X and Y as the tool setter location. Z is left alone."/>
						<Button Content="Set Z Here" FontSize="15" Height="40" Width="135"
								CornerRadius="6"
								HorizontalContentAlignment="Center"
								VerticalContentAlignment="Center"
								IsEnabled="{Binding CanStartProbe}"
								Command="{Binding SetToolSetterZCommand}"
								ToolTip.Tip="Store the current Z as the height probing starts from. The controller descends $342 from here, so leave clearance for your longest tool. X and Y are left alone."/>
					</StackPanel>

					<!-- Establishing the tool length reference is a pre-job step, done here
					     rather than during a tool change: it ends in $TLR, and $TLR after a
					     failed probe clears the reference instead of setting it. Doing it
					     before the job also keeps it away from a live stream. -->
					<Border Grid.Row="4" BorderBrush="AntiqueWhite" BorderThickness="1"
							Padding="8,6" Margin="0,8,0,0">
						<Grid RowDefinitions="Auto,Auto,Auto">
							<TextBlock Grid.Row="0"
									   FontSize="13" TextWrapping="Wrap"
									   HorizontalAlignment="Center"
									   Text="Tool length reference — probe once with the tool you zero the stock from, before starting the job."/>
							<!-- Two mutually exclusive labels rather than a converter, matching
							     how the rest of this view expresses boolean state. -->
							<TextBlock Grid.Row="1"
									   FontSize="13" FontWeight="DemiBold"
									   Margin="0,4,0,6"
									   HorizontalAlignment="Center"
									   Foreground="{DynamicResource OkBrush}"
									   Text="Reference is set"
									   IsVisible="{Binding ToolReferenceSet}"/>
							<TextBlock Grid.Row="1"
									   FontSize="13" FontWeight="DemiBold"
									   Margin="0,4,0,6"
									   HorizontalAlignment="Center"
									   Foreground="{DynamicResource AlertBrush}"
									   Text="No reference set"
									   IsVisible="{Binding !ToolReferenceSet}"/>
							<StackPanel Grid.Row="2" Orientation="Horizontal"
										HorizontalAlignment="Center" Spacing="8">
								<Button Content="Probe Here" FontSize="15" Height="40" Width="135"
										CornerRadius="6"
										HorizontalContentAlignment="Center"
										VerticalContentAlignment="Center"
										IsEnabled="{Binding CanStartProbe}"
										Command="{Binding ProbeToolReferenceHereCommand}"
										ToolTip.Tip="Probe straight down from where the machine is standing, then set the reference. Position the tool over the setter first."/>
								<Button Content="Probe at G59.3" FontSize="15" Height="40" Width="150"
										CornerRadius="6"
										HorizontalContentAlignment="Center"
										VerticalContentAlignment="Center"
										IsEnabled="{Binding CanStartProbe}"
										Command="{Binding ProbeToolReferenceAtSetterCommand}"
										ToolTip.Tip="Retract Z to machine zero, travel to the stored tool setter position, descend and probe, then set the reference."/>
							</StackPanel>
						</Grid>
					</Border>

					<TextBlock Grid.Row="5"
							   Text="{Binding ToolSetterStatus}"
							   FontSize="14"
							   HorizontalAlignment="Center"
							   Margin="0,6,0,0"
							   Foreground="{DynamicResource TextMutedBrush}"
							   IsVisible="{Binding ToolSetterStatus,
							   Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
				</Grid>
			</TabItem>
		</TabControl>

		<!-- Results Section.
		     Also hidden on the Tool Setter tab: a tool length reference probe sets no work
		     offsets, so these stay blank there and only take up room the tab needs. -->
		<Border Grid.Row="3" BorderThickness="1" CornerRadius="4" Padding="10,8" Margin="0,8,0,0"
				IsVisible="{Binding !#ToolSetterTab.IsSelected}">
			<Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,*" RowDefinitions="Auto">
				<Label Grid.Column="0" Content="X:" FontSize="16" FontWeight="Bold"
					   VerticalAlignment="Center" Margin="0,0,3,0"/>
				<Label Grid.Column="1" Content="{Binding ProbeXResult}" FontSize="16"
					   VerticalAlignment="Center" MinWidth="80" Margin="0,0,15,0"/>
				<Label Grid.Column="2" Content="Y:" FontSize="16" FontWeight="Bold"
					   VerticalAlignment="Center" Margin="0,0,3,0"/>
				<Label Grid.Column="3" Content="{Binding ProbeYResult}" FontSize="16"
					   VerticalAlignment="Center" MinWidth="80" Margin="0,0,15,0"/>
				<Label Grid.Column="4" Content="Z:" FontSize="16" FontWeight="Bold"
					   VerticalAlignment="Center" Margin="0,0,3,0"/>
				<Label Grid.Column="5" Content="{Binding ProbeZResult}" FontSize="16"
					   VerticalAlignment="Center" MinWidth="80" Margin="0,0,15,0"/>
			</Grid>
		</Border>
        <Label Grid.Row="4" Content="{Binding ProbeStatus}" FontSize="20"
               VerticalAlignment="Center" HorizontalAlignment="Left" 
			   Margin="20,0,0,0"
               Foreground="{DynamicResource SystemAccentColor}"/>
        <Button Grid.Row="5" 
                Content="Close"
                FontSize="20"
                Padding="0"
                Margin="0,10,0,0"
                Height="50" Width="160" 
                CornerRadius="6"
                HorizontalAlignment="Center" 
                VerticalAlignment="Center"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"
                IsEnabled="{Binding !IsProbing}"
                Command="{Binding CloseCommand}"/>
	</Grid>
</UserControl>
