<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:data="clr-namespace:GrbLHALSender.Data"
             xmlns:viewModels="clr-namespace:GrbLHALSender.ViewModels"
             d:DesignWidth="1400" d:DesignHeight="900"
             x:Class="GrbLHALSender.Views.CheatSheetView"
             x:DataType="viewModels:CheatSheetViewModel">

	<UserControl.Styles>
		<Style Selector="RadioButton.cat">
			<Setter Property="FontSize" Value="18"/>
			<Setter Property="Height" Value="42"/>
			<Setter Property="MinWidth" Value="110"/>
		</Style>

		<!-- Section titles and code labels take the accent; alarm sections stay on
		     the alert color, since "this is an alarm" is information the accent
		     shouldn't be allowed to erase. DynamicResource (not a converter) so
		     changing the accent repaints the list without rebuilding it. -->
		<Style Selector="TextBlock.entryCode">
			<Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
		</Style>
		<Style Selector="TextBlock.entryCode.alarm">
			<Setter Property="Foreground" Value="{DynamicResource AlertBrush}"/>
		</Style>
	</UserControl.Styles>

	<Grid RowDefinitions="Auto,*" Background="{DynamicResource AppBackgroundBrush}">

		<!-- Filter bar -->
		<Border Grid.Row="0"
		        Background="{DynamicResource SurfaceBrush}"
		        BorderBrush="{DynamicResource PanelBorderBrush}"
		        BorderThickness="0,0,0,2" Padding="10,8">
			<Grid ColumnDefinitions="*,Auto,Auto" >
				<TextBox Grid.Column="0"
				         Text="{Binding FilterText, Mode=TwoWay}"
				         Watermark="Filter… e.g. G38, probe, homing, alarm 9"
				         FontSize="20"
				         FontFamily="{DynamicResource MonoFontFamily}"
				         Height="45"
				         VerticalContentAlignment="Center"
				         Margin="0,0,10,0"/>
				<Button Grid.Column="1"
				        Classes="touch"
				        Content="Clear"
				        Width="110"
				        Margin="0,0,15,0"
				        Command="{Binding ClearFilterCommand}"/>
				<StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
					<RadioButton Classes="ButtonStyle cat" GroupName="CheatCat" IsChecked="True"
					             Content="All" Command="{Binding CategoryCommand}" CommandParameter="All"/>
					<RadioButton Classes="ButtonStyle cat" GroupName="CheatCat"
					             Content="G-codes" Command="{Binding CategoryCommand}" CommandParameter="G-codes"/>
					<RadioButton Classes="ButtonStyle cat" GroupName="CheatCat"
					             Content="M-codes" Command="{Binding CategoryCommand}" CommandParameter="M-codes"/>
					<RadioButton Classes="ButtonStyle cat" GroupName="CheatCat"
					             Content="Errors" Command="{Binding CategoryCommand}" CommandParameter="Errors"/>
					<RadioButton Classes="ButtonStyle cat" GroupName="CheatCat"
					             Content="Alarms" Command="{Binding CategoryCommand}" CommandParameter="Alarms"/>
					<RadioButton Classes="ButtonStyle cat" GroupName="CheatCat"
					             Content="Realtime" Command="{Binding CategoryCommand}" CommandParameter="Realtime"/>
				</StackPanel>
			</Grid>
		</Border>

		<!-- Sections -->
		<ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
			<ItemsControl ItemsSource="{Binding Sections}" Margin="15,10,15,30" MaxWidth="1100" HorizontalAlignment="Center">
				<ItemsControl.ItemTemplate>
					<DataTemplate x:DataType="data:CheatSection">
						<StackPanel Margin="0,18,0,0">
							<TextBlock Text="{Binding Title}"
							           Classes="sectionTitle entryCode"
							           Classes.alarm="{Binding IsAlarm}"
							           FontSize="19"/>
							<TextBlock Text="{Binding Subtitle}"
							           Classes="muted"
							           FontSize="15"
							           TextWrapping="Wrap"
							           Margin="0,2,0,8"/>
							<Border Classes="panel" Padding="0,4">
								<ItemsControl ItemsSource="{Binding Entries}">
									<ItemsControl.ItemTemplate>
										<DataTemplate x:DataType="data:CheatEntry">
											<Border Classes="row" Padding="14,8">
												<Grid ColumnDefinitions="160,*,Auto">
													<TextBlock Grid.Column="0"
													           Classes="code entryCode"
													           Classes.alarm="{Binding IsAlarm}"
													           Text="{Binding Code}"
													           FontSize="19"
													           FontWeight="SemiBold"
													           VerticalAlignment="Top"/>
													<StackPanel Grid.Column="1">
														<TextBlock Text="{Binding Description}"
														           Foreground="{DynamicResource TextPrimaryBrush}"
														           FontSize="17"
														           TextWrapping="Wrap"/>
														<TextBlock Text="{Binding Note}"
														           Classes="muted"
														           FontSize="14"
														           TextWrapping="Wrap"
														           Margin="0,2,0,0"
														           IsVisible="{Binding Note, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
													</StackPanel>
													<Border Grid.Column="2"
													        Background="{DynamicResource AccentSoftBrush}"
													        CornerRadius="3"
													        Padding="6,2"
													        Margin="10,0,0,0"
													        VerticalAlignment="Top"
													        IsVisible="{Binding IsHal}">
														<TextBlock Text="HAL"
														           Foreground="{DynamicResource AccentBrush}"
														           FontSize="12"
														           FontWeight="Bold"/>
													</Border>
												</Grid>
											</Border>
										</DataTemplate>
									</ItemsControl.ItemTemplate>
								</ItemsControl>
							</Border>
						</StackPanel>
					</DataTemplate>
				</ItemsControl.ItemTemplate>
			</ItemsControl>
		</ScrollViewer>
	</Grid>
</UserControl>
