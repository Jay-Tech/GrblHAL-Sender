<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:data="clr-namespace:GrbLHALSender.Data"
             xmlns:viewModels="clr-namespace:GrbLHALSender.ViewModels"
             d:DesignWidth="1400" d:DesignHeight="900"
             x:Class="GrbLHALSender.Views.CheatSheetView"
             x:DataType="viewModels:CheatSheetViewModel">

	<UserControl.Styles>
		<Style Selector="RadioButton.cat">
			<Setter Property="FontSize" Value="18"/>
			<Setter Property="Height" Value="42"/>
			<Setter Property="MinWidth" Value="110"/>
		</Style>
	</UserControl.Styles>

	<Grid RowDefinitions="Auto,*" Background="#16191D">

		<!-- Filter bar -->
		<Border Grid.Row="0" Background="#20252B" BorderBrush="#2C3238" BorderThickness="0,0,0,2" Padding="10,8">
			<Grid ColumnDefinitions="*,Auto,Auto" >
				<TextBox Grid.Column="0"
				         Text="{Binding FilterText, Mode=TwoWay}"
				         Watermark="Filter… e.g. G38, probe, homing, alarm 9"
				         FontSize="20"
				         FontFamily="Consolas,Cascadia Mono,DejaVu Sans Mono,monospace"
				         Height="45"
				         VerticalContentAlignment="Center"
				         Margin="0,0,10,0"/>
				<Button Grid.Column="1"
				        Content="Clear"
				        Height="45"
				        FontSize="18"
				        Margin="0,0,15,0"
				        VerticalContentAlignment="Center"
				        HorizontalContentAlignment="Center"
				        Command="{Binding ClearFilterCommand}"/>
				<StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
					<RadioButton Classes="ButtonStyle cat" GroupName="CheatCat" IsChecked="True"
					             Content="All" Command="{Binding CategoryCommand}" CommandParameter="All"/>
					<RadioButton Classes="ButtonStyle cat" GroupName="CheatCat"
					             Content="G-codes" Command="{Binding CategoryCommand}" CommandParameter="G-codes"/>
					<RadioButton Classes="ButtonStyle cat" GroupName="CheatCat"
					             Content="M-codes" Command="{Binding CategoryCommand}" CommandParameter="M-codes"/>
					<RadioButton Classes="ButtonStyle cat" GroupName="CheatCat"
					             Content="Errors" Command="{Binding CategoryCommand}" CommandParameter="Errors"/>
					<RadioButton Classes="ButtonStyle cat" GroupName="CheatCat"
					             Content="Alarms" Command="{Binding CategoryCommand}" CommandParameter="Alarms"/>
					<RadioButton Classes="ButtonStyle cat" GroupName="CheatCat"
					             Content="Realtime" Command="{Binding CategoryCommand}" CommandParameter="Realtime"/>
				</StackPanel>
			</Grid>
		</Border>

		<!-- Sections -->
		<ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
			<ItemsControl ItemsSource="{Binding Sections}" Margin="15,10,15,30" MaxWidth="1100" HorizontalAlignment="Center">
				<ItemsControl.ItemTemplate>
					<DataTemplate x:DataType="data:CheatSection">
						<StackPanel Margin="0,18,0,0">
							<TextBlock Text="{Binding Title}"
							           Foreground="{Binding TitleColor}"
							           FontSize="19"
							           FontWeight="Bold"
							           LetterSpacing="1.5"/>
							<TextBlock Text="{Binding Subtitle}"
							           Foreground="#98A2AC"
							           FontSize="15"
							           TextWrapping="Wrap"
							           Margin="0,2,0,8"/>
							<Border Background="#20252B" BorderBrush="#2C3238" BorderThickness="1" CornerRadius="6" Padding="0,4">
								<ItemsControl ItemsSource="{Binding Entries}">
									<ItemsControl.ItemTemplate>
										<DataTemplate x:DataType="data:CheatEntry">
											<Border BorderBrush="#2C3238" BorderThickness="0,0,0,1" Padding="14,8">
												<Grid ColumnDefinitions="160,*,Auto">
													<TextBlock Grid.Column="0"
													           Text="{Binding Code}"
													           Foreground="{Binding CodeColor}"
													           FontFamily="Consolas,Cascadia Mono,DejaVu Sans Mono,monospace"
													           FontSize="19"
													           FontWeight="SemiBold"
													           VerticalAlignment="Top"/>
													<StackPanel Grid.Column="1">
														<TextBlock Text="{Binding Description}"
														           Foreground="#E4E8EB"
														           FontSize="17"
														           TextWrapping="Wrap"/>
														<TextBlock Text="{Binding Note}"
														           Foreground="#98A2AC"
														           FontSize="14"
														           TextWrapping="Wrap"
														           Margin="0,2,0,0"
														           IsVisible="{Binding Note, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
													</StackPanel>
													<Border Grid.Column="2"
													        Background="#33290F"
													        CornerRadius="3"
													        Padding="6,2"
													        Margin="10,0,0,0"
													        VerticalAlignment="Top"
													        IsVisible="{Binding IsHal}">
														<TextBlock Text="HAL"
														           Foreground="#E8A02E"
														           FontSize="12"
														           FontWeight="Bold"/>
													</Border>
												</Grid>
											</Border>
										</DataTemplate>
									</ItemsControl.ItemTemplate>
								</ItemsControl>
							</Border>
						</StackPanel>
					</DataTemplate>
				</ItemsControl.ItemTemplate>
			</ItemsControl>
		</ScrollViewer>
	</Grid>
</UserControl>
