<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:GrbLHALSender.ViewModels"
             mc:Ignorable="d"
             d:DesignWidth="600" d:DesignHeight="45"
             x:Class="GrbLHALSender.Views.MacroBarView"
             x:DataType="viewModels:MainViewModel">

	<!-- The macro buttons, without the tab-strip spacer that precedes them on the landscape
	     canvas. That spacer's width binds to a TabItem in WorkspacePanelView's namescope, so it
	     cannot travel with this component, and it means nothing anywhere there is no tab strip
	     to clear. WorkspacePanelView keeps it and places this alongside. -->
	<Grid ColumnDefinitions="Auto,*">
		<Label Grid.Column="0"
			   Margin="25,5,10,0"
			   Content="MACROS:"
			   VerticalAlignment="Bottom"
			   VerticalContentAlignment="Center"
			   FontSize="{DynamicResource BaseFontSize}"
			   IsVisible="{Binding MacroViewModel.MacroList.Count }"/>
		<!--IsEnabled on the repeater rather than the templated button:
		    it propagates to the children, and inside the template the
		    DataContext is a Macro item, not the view model.-->
		<ItemsRepeater Grid.Column="1" x:Name="MacroRepeater"
					   HorizontalAlignment="Left"
					   VerticalAlignment="Bottom"
					   IsEnabled="{Binding MacroViewModel.CanRunMacro}"
					   ItemsSource="{Binding MacroViewModel.MacroList}"
					   Margin="0,0">
			<ItemsRepeater.Layout>
				<UniformGridLayout MinColumnSpacing="10"></UniformGridLayout>
			</ItemsRepeater.Layout>
			<ItemsRepeater.ItemTemplate>
				<DataTemplate>
					<Button Content="{Binding   Path=Id}"
							Width="115" Height="40"
							HorizontalAlignment="Left"
							VerticalAlignment="Bottom"
							HorizontalContentAlignment="Center"
							VerticalContentAlignment="Center"
							CornerRadius="6,6,6,6"
							Margin="0,0,0,0"
							CommandParameter="{Binding  Id}"
							FontSize="{DynamicResource DetailFontSizeLarge}"
							Command="{Binding #MacroRepeater.((viewModels:MainViewModel)DataContext).MacroViewModel.RunMacroCommand}">
					</Button>
				</DataTemplate>
			</ItemsRepeater.ItemTemplate>
		</ItemsRepeater>
	</Grid>
</UserControl>
