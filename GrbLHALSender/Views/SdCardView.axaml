<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:viewModels="clr-namespace:GrbLHALSender.ViewModels"
			 xmlns:sdCard="clr-namespace:GrbLHALSender.SdCard"
			 xmlns:icons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
			 x:Class="GrbLHALSender.Views.SdCardView"
			 x:DataType="viewModels:SdCardViewModel"
			 mc:Ignorable="d"
			 d:DesignWidth="600" d:DesignHeight="500">

	<Grid RowDefinitions="Auto,*,Auto">

		<!-- Toolbar -->
		<Border Grid.Row="0" Padding="8" Background="{DynamicResource MaterialPaperBrush}">
			<Grid ColumnDefinitions="*,Auto">
				<StackPanel Orientation="Horizontal" Spacing="6" Grid.Column="0">
					<Button Command="{Binding RefreshCommand}"
							ToolTip.Tip="Mount SD card and refresh file list"
							Padding="6,4">
						<StackPanel Orientation="Horizontal" Spacing="4">
							<ContentControl Content="{icons:MaterialIconExt Kind=Refresh, Size=16}" />
							<TextBlock Text="Refresh" VerticalAlignment="Center"
									   FontSize="{DynamicResource BaseFontSize}" />
						</StackPanel>
					</Button>

					<Button Command="{Binding UploadCommand}"
							IsEnabled="{Binding !IsTransferring}"
							ToolTip.Tip="Upload a file to the SD card"
							Padding="6,4">
						<StackPanel Orientation="Horizontal" Spacing="4">
							<ContentControl Content="{icons:MaterialIconExt Kind=Upload, Size=16}" />
							<TextBlock Text="Up/L" VerticalAlignment="Center"
									   FontSize="{DynamicResource BaseFontSize}" />
						</StackPanel>
					</Button>

					<Button Command="{Binding DownloadCommand}"
							IsEnabled="{Binding SelectedFile, Converter={x:Static ObjectConverters.IsNotNull}}"
							ToolTip.Tip="Download selected file from the SD card"
							Padding="6,4">
						<StackPanel Orientation="Horizontal" Spacing="4">
							<ContentControl Content="{icons:MaterialIconExt Kind=Download, Size=16}" />
							<TextBlock Text="Down/L" VerticalAlignment="Center"
									   FontSize="{DynamicResource BaseFontSize}" />
						</StackPanel>
					</Button>

					<Button Command="{Binding DeleteCommand}"
							IsEnabled="{Binding SelectedFile, Converter={x:Static ObjectConverters.IsNotNull}}"
							ToolTip.Tip="Delete selected file from the SD card"
							Padding="6,4">
						<StackPanel Orientation="Horizontal" Spacing="4">
							<ContentControl Content="{icons:MaterialIconExt Kind=Delete, Size=16}" />
							<TextBlock Text="Delete" VerticalAlignment="Center"
									   FontSize="{DynamicResource BaseFontSize}" />
						</StackPanel>
					</Button>

					<Button Command="{Binding RunCommand}"
							IsEnabled="{Binding SelectedFile, Converter={x:Static ObjectConverters.IsNotNull}}"
							ToolTip.Tip="Run selected G-code file from the SD card"
							Padding="6,4">
						<StackPanel Orientation="Horizontal" Spacing="4">
							<ContentControl Content="{icons:MaterialIconExt Kind=Play, Size=16}" />
							<TextBlock Text="Run" VerticalAlignment="Center"
									   FontSize="{DynamicResource BaseFontSize}" />
						</StackPanel>
					</Button>
				</StackPanel>

				<!-- Transfer mode indicator -->
				<Border Grid.Column="1"  Padding="6,4,2,4" CornerRadius="4"
						Background="{DynamicResource MaterialBodyBrush}" Opacity="0.7">
					<TextBlock  Text="{Binding TransferModeDisplay}"
							   VerticalAlignment="Center" 
							   FontSize="{DynamicResource BaseFontSize}"
							   FontWeight="DemiBold" />
				</Border>
			</Grid>
		</Border>

		<!-- File List -->
		<Border Grid.Row="1" Margin="4">
			<ListBox ItemsSource="{Binding Files}"
					 SelectedItem="{Binding SelectedFile}"
					 SelectionMode="Single">
				<ListBox.ItemTemplate>
					<DataTemplate x:DataType="sdCard:SdCardFileInfo">
						<Grid ColumnDefinitions="*,Auto" Margin="4,2">
							<TextBlock Grid.Column="0"
									   Text="{Binding FileName}"
									   VerticalAlignment="Center"
									   FontSize="{DynamicResource BaseFontSize}" />
							<TextBlock Grid.Column="1"
									   Text="{Binding DisplaySize}"
									   VerticalAlignment="Center"
									   Opacity="0.6"
									   FontSize="{DynamicResource BaseFontSize}"
									   Margin="16,0,0,0" />
						</Grid>
					</DataTemplate>
				</ListBox.ItemTemplate>
			</ListBox>
		</Border>

		<!-- Status / Progress Bar -->
		<Border Grid.Row="2" Padding="8,4" Background="{DynamicResource MaterialPaperBrush}">
			<Grid ColumnDefinitions="*,Auto">
				<StackPanel Grid.Column="0" Spacing="4">
					<!-- Progress bar (visible during transfer) -->
					<ProgressBar Value="{Binding TransferProgress}"
								 Minimum="0" Maximum="100"
								 IsVisible="{Binding IsTransferring}"
								 Height="16" />

					<!-- Status text -->
					<TextBlock FontSize="{DynamicResource BaseFontSize}">
						<TextBlock.Text>
							<MultiBinding StringFormat="{}{0} {1}">
								<Binding Path="TransferStatus" />
								<Binding Path="StatusMessage" />
							</MultiBinding>
						</TextBlock.Text>
					</TextBlock>
				</StackPanel>

				<!-- Cancel button -->
				<Button Grid.Column="1"
						Command="{Binding CancelTransferCommand}"
						IsVisible="{Binding IsTransferring}"
						ToolTip.Tip="Cancel transfer"
						Padding="4">
					<ContentControl Content="{icons:MaterialIconExt Kind=Close, Size=18}" />
				</Button>
			</Grid>
		</Border>

	</Grid>
</UserControl>
