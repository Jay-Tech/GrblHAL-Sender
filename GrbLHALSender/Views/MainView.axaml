<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:viewModels="clr-namespace:GrbLHALSender.ViewModels"
             xmlns:views="clr-namespace:GrbLHALSender.Views"
			 d:DesignWidth="1920" d:DesignHeight="1080"
			 x:Class="GrbLHALSender.Views.MainView"
			 x:DataType="viewModels:MainViewModel">

	<!--Header-->
	<!-- Page fill comes from the palette, not the Fluent theme's RegionColor, so
	     switching preset actually repaints the background behind every panel. -->
	<Grid x:Name="MainGrid"  RowDefinitions="Auto, *" Background="{DynamicResource AppBackgroundBrush}" >
		<Border x:Name="HeaderBorder" Grid.Row="0"  Grid.ColumnSpan="3" Height="45" BorderThickness="1"  >
			<views:HeaderView />
		</Border>
		<!-- End Header-->

		<!-- START Content Grid-->
		<Grid Grid.Row="1" x:Name="ContentGrid" ColumnDefinitions="Auto,*,Auto">
			<!-- START Left Controls DRO, MDI-->
			<!-- The three columns are exactly adjacent, so every visible gap comes from the
			     panels' own content. The jog panel's buttons carry a 5px margin inside its
			     border; this panel's controls stretch flush to theirs, which left the render
			     area optically off-centre. This gutter matches the two. -->
			<Border  Grid.Column="0"
					 IsEnabled="{Binding Connected}"
					 Name="DroBorder"
					 Margin="0,50,5,0"
					 MaxWidth="300" MinWidth="295"
					 VerticalAlignment="Stretch"
					  >
				<views:DroPanelView />
			</Border>
			<!--END Left Control-->

			<!--START Center Content Control -->
			<Border  Grid.Column="1" >
				<views:WorkspacePanelView />
			</Border>
			<!-- END Center Content Control -->

			<!--START Right Control-->
			<Border IsEnabled ="{Binding Connected}" x:Name="JogBorder"  Grid.Column="2"
					MaxWidth="330" MinWidth="325" >
				<views:JogPanelView Margin="0,45,0,0" />
			</Border>
			<!--END Right Section End-->
		</Grid>
		<!--END Content Grid -->

		<!-- Dialog overlays. Same reasoning as the keyboard below: in-window
		     panels instead of child OS windows, so positioning works on
		     Wayland and focus never leaves the main window.
		     DialogHost is single-slot (probe/macro/surfacing/config replace
		     each other); ConsoleHost is independent so the console can stay
		     open for monitoring while a tool dialog is up. -->
		<views:DialogHostView x:Name="DialogHost"
							  Grid.Row="0" Grid.RowSpan="2"
							  HorizontalAlignment="Left"
							  VerticalAlignment="Bottom"
							  Margin="300,0,0,60"
							  ZIndex="900"/>
		<views:DialogHostView x:Name="ConsoleHost"
							  Grid.Row="0" Grid.RowSpan="2"
							  HorizontalAlignment="Right"
							  VerticalAlignment="Bottom"
							  Margin="0,0,15,60"
							  ZIndex="890"/>

		<!-- Virtual keyboard overlay. Lives INSIDE the main window (not a
		     separate OS window) so the window manager is never involved:
		     no activation dance, no focus loss on close, and drag is a
		     simple render transform. Shown on TextBox double-tap. -->
		<views:VirtualKeyboardView x:Name="KeyboardOverlay"
								   Grid.Row="0" Grid.RowSpan="2"
								   Width="750"
								   HorizontalAlignment="Center"
								   VerticalAlignment="Bottom"
								   Margin="0,0,0,60"
								   ZIndex="1000"
								   IsVisible="False"/>
	</Grid>
	<!--END Main Grid -->
</UserControl>