<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:converters="clr-namespace:Avalonia.Controls.Converters;assembly=Avalonia.Controls"
			 xmlns:viewModels="clr-namespace:GrbLHALSender.ViewModels"
			 xmlns:convertors="clr-namespace:GrbLHALSender.Convertors"
			 xmlns:utility="clr-namespace:GrbLHALSender.Utility"
			 mc:Ignorable="d" d:DesignWidth="1500" d:DesignHeight="250"
			 x:Class="GrbLHALSender.Views.JobButtonView"
			 x:DataType="viewModels:JobViewModel">
	<!--<Design.DataContext>
		<viewModels:JobViewModel/>
	</Design.DataContext>-->
	<UserControl.Resources>
	</UserControl.Resources>
	<UserControl.Styles>
		<!-- Size/spacing that is specific to this button row. Everything else
		     (height, radius, font size, content centering) comes from .touch. -->
		<Style Selector="Button.touch">
			<Setter Property="HorizontalAlignment" Value="Center"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
			<Setter Property="Width" Value="115"/>
			<Setter Property="Margin" Value="15,5,15,0"/>
			<Setter Property="BorderThickness" Value="3"/>
		</Style>

		<!-- Tool length reference state, from the TLR field of the status report.
		     DynamicResource rather than a converter so it repaints on a theme change
		     instead of holding the old palette until TLR next flips. -->
		<Style Selector="Border.tlrRing">
			<Setter Property="BorderBrush" Value="{DynamicResource AlertBrush}"/>
		</Style>
		<Style Selector="Border.tlrRing.good">
			<Setter Property="BorderBrush" Value="{DynamicResource OkBrush}"/>
		</Style>
	</UserControl.Styles>
	<Grid  Background="Transparent"  ColumnDefinitions="*,*,*,*,*,*"  RowDefinitions="Auto,Auto,Auto,Auto,Auto"
		   Opacity=".6"
		   VerticalAlignment="Stretch"
		   HorizontalAlignment="Center">
		<Button Classes="touch" Grid.Row="0" Grid.Column="0" BorderBrush="{Binding }"
				Command="{Binding  SelectFilesCommand}"
				IsEnabled="{Binding !FileLoaded}"
				Content="File"/>
		<Button Classes="touch" Grid.Row="0"  Grid.Column="1"
                Command="{Binding  CloseFilesCommand}"
                IsEnabled="{Binding FileLoaded}"
                Content="Close"/>
		<Button Classes="touch" Grid.Row="0"  Grid.Column="2"
                Content="Stop"
				IsEnabled="{Binding JobRunning}"
                Command="{Binding StopJobCommand}"/>
		<Button Classes="touch" Grid.Row="0" Grid.Column="3"
                Content="Hold"
                IsEnabled="{Binding CanHoldJob}"
                Command="{Binding PauseJobCommand}"/>
		<Button Classes="touch" Grid.Row="0" Grid.Column="4"
                Content="Start"
                IsEnabled="{Binding CanStartJob}"
                Command="{Binding StartJobCommand}"/>
		<Button Classes="touch" Grid.Row="0" Grid.Column="5"
                Content="G-code"
                Command="{Binding OpenGCodePanel}"
                IsEnabled="{Binding FileLoaded}"/>
		<Grid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="6" ColumnDefinitions="2*,*,*">
		<TextBlock x:Name="FileTextBlock"
                   Margin="15,15"
				   FontSize="{DynamicResource BaseFontSize}"
				   Grid.Column="0"
				   HorizontalAlignment="Left"
				   VerticalAlignment="Center"
				   Text="{Binding FileName}"/>
		<TextBlock x:Name="EstimatedTextBlock"
                   Margin="0,15"
                   FontSize="{DynamicResource BaseFontSize}"
				   Grid.Column="1"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Center"
				   Text ="{Binding EstimatedTime}"/>
        <TextBlock x:Name="RunTimeTextBlock"
                   Margin="25,15,0,15"
				   Width="250"
                   FontSize="{DynamicResource BaseFontSize}"
                   Grid.Column="2"
				   IsVisible="{Binding FileLoaded}"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Center"
				   TextAlignment="Left"
                   Text ="{Binding RunTime, StringFormat=RunTime:{0}, FallbackValue=00:00:00}"/>
        </Grid>
		<TextBlock Grid.Column="0" Grid.Row="2" Grid.ColumnSpan="6"
				   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
				   Margin="15,0" 
                   FontSize="{DynamicResource BaseFontSize}"
				   Text="{Binding SelectedLineInfo}"
				   IsVisible="{Binding SelectedLineInfo, 
				   Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
        <TextBlock Grid.Column="0" Grid.Row="3" Grid.ColumnSpan="6"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
				   FontWeight="DemiBold"
                   Margin="15,0"
				   Foreground="{DynamicResource AlertBrush}"
                   FontSize="{DynamicResource XlFontSize}"
                   Text="TOOL"
                   IsVisible="{Binding ToolChangeVisible}"/>
		<!-- grblHAL's manual tool change modes need the new tool probed before cycle start,
		     and there was previously no way to send either command except MDI. Hidden
		     unless $341 says this machine has that step.
		     Left-hand columns on purpose: the g-code viewer opens over the right side of
		     the home tab and would cover them there. -->
		<StackPanel Grid.Column="0" Grid.Row="3" Grid.ColumnSpan="2"
					Orientation="Horizontal"
					Spacing="8"
					HorizontalAlignment="Center"
					VerticalAlignment="Center"
					IsVisible="{Binding TouchOffVisible}">
			<Button Content="Touch Off"
					FontSize="15"
					Height="38" Width="125"
					CornerRadius="6"
					HorizontalContentAlignment="Center"
					VerticalContentAlignment="Center"
					Command="{Binding TouchOffCommand}"
					ToolTip.Tip="Probe the new tool and apply its offset ($TPW), then press Start."/>
			<!-- Ring rather than the button's own colours: the Fluent theme repaints a
			     Button's border on :pointerover/:pressed, and those states stick after a
			     touch, which would hide the bound state until focus moved elsewhere.
			     Same reason the aux output buttons use a wrapper. -->
			<Border Classes="tlrRing"
					Classes.good="{Binding ToolReferenceSet}"
					BorderThickness="2"
					CornerRadius="6">
				<Button Content="Set Ref"
						FontSize="15"
						Height="38" Width="125"
						CornerRadius="6"
						BorderThickness="0"
						HorizontalContentAlignment="Center"
						VerticalContentAlignment="Center"
						Command="{Binding SetToolReferenceCommand}"
						IsEnabled="{Binding !ToolReferenceSet}"
						ToolTip.Tip="Capture the probe just taken as the tool length reference ($TLR). Red and enabled means the controller holds no reference and $TPW has nothing to measure against — press Touch Off first, then this. Disabled once a reference exists, so a stray press cannot re-base the datum onto the wrong tool; to deliberately re-establish it, send $TLR from MDI."/>
			</Border>
		</StackPanel>
		<!-- Shares row 3 with TOOL: a tool change and an aborted job cannot both be
		     current, and a job stopped by a rejected line must not be silent. -->
		<TextBlock Grid.Column="0" Grid.Row="3" Grid.ColumnSpan="6"
				   HorizontalAlignment="Center"
				   VerticalAlignment="Center"
				   FontWeight="DemiBold"
				   Margin="15,0"
				   TextWrapping="Wrap"
				   Foreground="{DynamicResource AlertBrush}"
				   FontSize="{DynamicResource BaseFontSize}"
				   Text="{Binding JobError}"
				   IsVisible="{Binding JobError,
				   Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
		<!-- What the controller said, e.g. a tool change macro's (debug, ...) text. Its
		     own row because it can appear alongside the TOOL banner: a macro that stops on
		     "manually unload tool 3 and unlock to continue" needs both showing at once. -->
		<TextBlock Grid.Column="0" Grid.Row="4" Grid.ColumnSpan="6"
				   HorizontalAlignment="Center"
				   VerticalAlignment="Center"
				   Margin="15,2,15,0"
				   TextWrapping="Wrap"
				   Foreground="{DynamicResource TextPrimaryBrush}"
				   FontSize="{DynamicResource DetailFontSizeLarge}"
				   Text="{Binding ControllerMessage}"
				   IsVisible="{Binding ControllerMessage,
				   Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
	</Grid>
</UserControl>
