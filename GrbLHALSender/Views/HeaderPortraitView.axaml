<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:GrbLHALSender.ViewModels"
             mc:Ignorable="d"
             d:DesignWidth="1080" d:DesignHeight="90"
             x:Class="GrbLHALSender.Views.HeaderPortraitView"
             x:DataType="viewModels:MainViewModel">

	<!-- The same values as HeaderView, in two 45px rows instead of one.
	     The landscape strip cannot be reflowed for this canvas: its fixed columns total
	     1205px before the two Auto ones, so it overflows 1080 before any content is
	     considered. Row 0 carries what identifies the machine's state, row 1 the jog and
	     unit readouts plus the signal LEDs. -->
	<Grid RowDefinitions="45,45">

		<!-- Row 0: connect, state, WCS, tool, alarm, unlock/close -->
		<Grid Grid.Row="0" ColumnDefinitions="125,100,130,120,*,Auto,Auto">
			<StackPanel Grid.Column="0" Orientation="Horizontal">
				<Button  Margin="3,0,0,0"
						 HorizontalAlignment="Left"
						 VerticalAlignment="Center"
						 VerticalContentAlignment="Center"
						 HorizontalContentAlignment="Center"
						 Height="40"  FontSize="24"
						 Content="Connect" x:Name="ConnectButton"
						 Command="{Binding ConnectCommand}"/>

				<Label Classes.active="{Binding Connected, FallbackValue=false}"
					   Classes.inactive="{Binding !Connected, FallbackValue=true}"
					   HorizontalContentAlignment="Center"
					   VerticalContentAlignment="Center"
					   HorizontalAlignment="Left"
					   CornerRadius="0,3,3,0"
					   VerticalAlignment="Center"
					   Width="10"
					   Height="40"/>
			</StackPanel>

			<Label Grid.Column="1"
				   FontSize="{DynamicResource BaseFontSize}"
				   Margin="10,0,0,0"
				   HorizontalAlignment="Left"
				   VerticalAlignment="Center"
				   Content="{Binding GrblHalState}" />
			<Label Grid.Column="2"
				   FontSize="{DynamicResource BaseFontSize}"
				   VerticalAlignment="Center"
				   HorizontalAlignment="Left"
				   Content="{Binding WcsDisplay, StringFormat={}WCS:{0}}"
				   IsVisible="{Binding Connected}"/>
			<Label Grid.Column="3"
				   FontSize="{DynamicResource BaseFontSize}"
				   VerticalAlignment="Center"
				   HorizontalAlignment="Left"
				   Content="{Binding ToolDisplay, StringFormat={} Tool:{0}}"
				   IsVisible="{Binding Connected}"/>

			<Button Grid.Column="5"
					x:Name="AlButton"
					IsVisible="{Binding AlarmActive}"
					Height="40"
					Content="{Binding SubState,StringFormat={} Alarm{0}}"
					FontSize="18"
					Width="100"
					VerticalAlignment="Center"
					HorizontalAlignment="Right"
					HorizontalContentAlignment="Center"
					VerticalContentAlignment="Center"
					Command="{Binding ClearAlarmCommand}"
					Margin="2,0"
					Classes="danger">
			</Button>
			<Grid Grid.Column="6" ColumnDefinitions="Auto,Auto">
				<Button Grid.Column="0"
						Height="40"
						Content="Unlock"
						FontSize="{DynamicResource BaseFontSize}"
						Margin="5,0"
						VerticalAlignment="Center"
						HorizontalAlignment="Right"
						VerticalContentAlignment="Center"
						HorizontalContentAlignment="Center"
						Command="{Binding UnLockCommand}"
						Width="105" />
				<Button Grid.Column="1"
						Height="40"
						Content="Close"
						IsVisible="{Binding IsFullScreen}"
						FontSize="{DynamicResource BaseFontSize}"
						Padding="5,2"
						Margin="5,0"
						VerticalAlignment="Center"
						HorizontalAlignment="Right"
						VerticalContentAlignment="Center"
						HorizontalContentAlignment="Center"
						Command="{Binding CloseCommand}"
						Width="105" />
			</Grid>
		</Grid>

		<!-- Row 1: jog step and feed, units, signal LEDs -->
		<Grid Grid.Row="1" ColumnDefinitions="150,150,215,215,*">
			<Label Grid.Column="0"
				   x:Name="JogStepLabel"
				   FontSize="{DynamicResource BaseFontSize}"
				   Margin="10,0,0,0"
				   VerticalAlignment="Center"
				   HorizontalAlignment="Left"
				   Content="{Binding JogStep, StringFormat={} Step:{0}}"
				   IsVisible="{Binding Connected}"/>
			<Label Grid.Column="1"
				   FontSize="{DynamicResource BaseFontSize}"
				   VerticalAlignment="Center"
				   HorizontalAlignment="Left" x:Name="JogFeedLabel"
				   Content="{Binding JogRate, StringFormat={} Feed:{0}}"
				   IsVisible="{Binding Connected}"/>
			<Label Grid.Column="2"
				   FontSize="{DynamicResource BaseFontSize}"
				   VerticalAlignment="Center"
				   Classes.metric="{Binding UseMetric}"
				   Classes.imperial="{Binding !UseMetric}"
				   HorizontalAlignment="Left" x:Name="DisplayUnitLabel"
				   IsVisible="{Binding Connected}">
			</Label>
			<Label Grid.Column="3"
				   FontSize="{DynamicResource BaseFontSize}"
				   VerticalAlignment="Center"
				   Classes.machineMetric="{Binding MachineSettings.ReportInMetric}"
				   Classes.machineImperial="{Binding !MachineSettings.ReportInMetric}"
				   HorizontalAlignment="Left" x:Name="MachineUnitLabel"
				   IsVisible="{Binding Connected}">
			</Label>

			<ItemsRepeater Grid.Column="4"
						   IsVisible="{Binding Connected}"
						   ClipToBounds="True"
						   HorizontalAlignment="Stretch"
						   Margin="15,0,15,0"
						   VerticalAlignment="Stretch"
						   ItemsSource="{Binding SignalList}">
				<ItemsRepeater.Layout>
					<StackLayout Orientation="Horizontal" Spacing="3"/>
				</ItemsRepeater.Layout >
				<ItemsRepeater.ItemTemplate>
					<DataTemplate>
						<Label Classes="led"
							   Classes.triggered="{Binding Triggered}"
							   VerticalAlignment="Center"
							   ClipToBounds="True"
							   VerticalContentAlignment="Center"
							   HorizontalAlignment="Center"
							   CornerRadius="45"
							   HorizontalContentAlignment="Center"
							   Margin="3 0"
							   Height="30" Width="30" FontWeight="Bold"
							   FontSize="{DynamicResource DetailFontSize}"
							   Content="{Binding Path=Id }"/>
					</DataTemplate>
				</ItemsRepeater.ItemTemplate>
			</ItemsRepeater>
		</Grid>
	</Grid>
</UserControl>
