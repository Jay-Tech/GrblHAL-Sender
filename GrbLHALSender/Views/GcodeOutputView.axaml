<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:viewModels="clr-namespace:GrbLHALSender.ViewModels"
			 xmlns:ae="https://github.com/avaloniaui/avaloniaedit"
			 mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
			 x:DataType="viewModels:JobViewModel"
			 x:Class="GrbLHALSender.Views.GcodeOutputView">
	<Design.DataContext>
		<viewModels:JobViewModel/>
	</Design.DataContext>

	<UserControl.Resources>
		<FontFamily x:Key="ConsoleFont">Cascadia Mono,Consolas,Menlo,DejaVu Sans Mono,monospace</FontFamily>
	</UserControl.Resources>

	<Border HorizontalAlignment="Right" VerticalAlignment="Stretch"
			Background="{StaticResource DarkReduceBrushAlpha}"
			BorderBrush="#33FFFFFF" BorderThickness="1"
			CornerRadius="4" Margin="0,60,5,75"
			Padding="2"
			MaxWidth="420" MinWidth="350">
		<ae:TextEditor x:Name="GCodeEditor"
					   IsReadOnly="True"
					   ShowLineNumbers="False"
					   FontFamily="{StaticResource ConsoleFont}"
					   FontSize="14"
					   Background="Transparent"
					   Foreground="#FFE8E8E8"
					   HorizontalScrollBarVisibility="Auto"
					   VerticalScrollBarVisibility="Auto" />
	</Border>
</UserControl>
