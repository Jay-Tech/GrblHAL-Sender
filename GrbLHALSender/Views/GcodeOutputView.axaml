<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:viewModels="clr-namespace:GrbLHALSender.ViewModels"
			 xmlns:ae="https://github.com/avaloniaui/avaloniaedit"
			 mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
			 x:DataType="viewModels:JobViewModel"
			 x:Class="GrbLHALSender.Views.GcodeOutputView">
	<Design.DataContext>
		<viewModels:JobViewModel/>
	</Design.DataContext>

	<Border Classes="overlayPanel"
			HorizontalAlignment="Right" VerticalAlignment="Stretch"
			Margin="0,60,5,75"
			Padding="2"
			MaxWidth="420" MinWidth="350">
		<ae:TextEditor x:Name="GCodeEditor"
					   IsReadOnly="True"
					   ShowLineNumbers="False"
					   FontFamily="{DynamicResource MonoFontFamily}"
					   FontSize="14"
					   Background="Transparent"
					   Foreground="{DynamicResource TextPrimaryBrush}"
					   HorizontalScrollBarVisibility="Auto"
					   VerticalScrollBarVisibility="Auto" />
	</Border>
</UserControl>
