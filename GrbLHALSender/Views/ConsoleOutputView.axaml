<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:GrbLHALSender.ViewModels"
             xmlns:behaviors="clr-namespace:GrbLHALSender.Behaviors"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:DataType="viewModels:MainViewModel"
             x:Class="GrbLHALSender.Views.ConsoleOutputView">
    
    <Design.DataContext>
        <viewModels:MainViewModel/>
    </Design.DataContext>
    
    <Border HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <Grid RowDefinitions="*,Auto">
            <ListBox Grid.Row="0" x:Name="ConsoleListBox" ItemsSource="{Binding ConsoleOutput}"
                     Background="{StaticResource DarkReduceBrushAlpha}"
                     Foreground="White"
                     FontSize="18">
                <Interaction.Behaviors>
                    <behaviors:ScrollToEndBehavior />
                </Interaction.Behaviors>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Foreground="GhostWhite" Margin="0,1"
                                   FontWeight="Bold" Opacity="1.0" Text="{Binding}" FontSize="18"
                                   HorizontalAlignment="Stretch" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <Grid Grid.Row="1"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch"
                  ColumnDefinitions="*,*">
                <Button Grid.Column="0" 
                        Height="40" 
                        Command="{Binding ClearConsoleCommand}"
                        Content="Clear"
                        Margin="10,0,10,0"
                        VerticalAlignment="Stretch"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        FontSize="20" />
                <Button Grid.Column="1" Height="40" 
                        Command="{Binding ToggleRtCommand}"
                        Content="Toggle Rt"
                        Margin="10,0,10,0"
                        VerticalAlignment="Stretch"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        FontSize="20" />
            </Grid>
        </Grid>
    </Border>
</UserControl>
