<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:GrbLHALSender.ViewModels"
             xmlns:behaviors="clr-namespace:GrbLHALSender.Behaviors"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:DataType="viewModels:MainViewModel"
             x:Class="GrbLHALSender.Views.ConsoleOutputView">

    <Design.DataContext>
        <viewModels:MainViewModel/>
    </Design.DataContext>

    <UserControl.Styles>
        <!-- Strip ListBoxItem selection chrome so it doesn't fight with text selection. -->
        <Style Selector="ListBox.console &gt; ListBoxItem">
            <Setter Property="Padding" Value="6,1" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="ListBox.console &gt; ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBox.console &gt; ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
        </Style>
    </UserControl.Styles>

    <Border Classes="overlayPanel"
            HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
            Padding="2">
        <Grid RowDefinitions="*,Auto">
            <ListBox Grid.Row="0"
                     Classes="console"
                     x:Name="ConsoleListBox"
                     ItemsSource="{Binding ConsoleOutput}"
                     SelectedIndex="{Binding ConsoleOutputIndex}"
                     Background="Transparent"
                     BorderThickness="0"
                     FontFamily="{DynamicResource MonoFontFamily}"
                     FontSize="14"
                     Foreground="{DynamicResource TextPrimaryBrush}"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                <!-- Non-virtualized panel: the default VirtualizingStackPanel
                     corrupts its realized containers under streaming appends
                     with variable-width lines + per-tick scroll-to-selected
                     (blank rows, overlapping text, bottom-up fill). The console
                     is capped at 500 lines, so a plain StackPanel is cheap. -->
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <SelectableTextBlock Text="{Binding}"
                                             FontFamily="{DynamicResource MonoFontFamily}"
                                             FontSize="14"
                                             Foreground="{DynamicResource TextPrimaryBrush}"
                                             SelectionBrush="{DynamicResource SelectionBrush}"
                                             HorizontalAlignment="Stretch" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Grid Grid.Row="1"
                  Margin="0,6,0,0"
                  HorizontalAlignment="Stretch"
                  ColumnDefinitions="*,*,*,*">
                <Button Grid.Column="0"
                        Classes="touch-sm"
                        Command="{Binding ClearConsoleCommand}"
                        Content="Clear"
                        Margin="6,0,6,0" />
                <Button Grid.Column="1"
                        Classes="touch-sm"
                        Click="OnCopyAllClick"
                        Content="Copy All"
                        Margin="6,0,6,0" />
                <Button Grid.Column="2"
                        Classes="touch-sm"
                        Command="{Binding ToggleRtCommand}"
                        Content="Toggle Rt"
                        Margin="6,0,6,0" />
                <Button Grid.Column="3"
                        Classes="touch-sm"
                        Command="{Binding CloseConsoleCommand}"
                        Content="Close"
                        Margin="6,0,6,0" />
            </Grid>
        </Grid>
    </Border>
</UserControl>
