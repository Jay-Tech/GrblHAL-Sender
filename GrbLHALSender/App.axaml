<Application xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 x:Class="GrbLHALSender.App"
			 RequestedThemeVariant="Dark"
			 xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
			 xmlns:sys="clr-namespace:System;assembly=System.Runtime">

	<!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->
	<Application.Resources>

		<!-- Colors are NOT declared here. ThemeService installs the whole semantic
		     palette (SurfaceBrush, AccentBrush, TextPrimaryBrush, …) as a merged
		     dictionary at startup and swaps it whenever the user changes the theme,
		     which is what makes accent changes apply without a restart.
		     Only theme-independent values belong in this block. -->

		<FontFamily x:Key="MonoFontFamily">Cascadia Mono,Consolas,Menlo,DejaVu Sans Mono,monospace</FontFamily>

		<sys:Double x:Key="TinyFontSize">12</sys:Double>
		<sys:Double x:Key="SmallFontSize">18</sys:Double>
		<sys:Double x:Key="DetailFontSize">20</sys:Double>
		<sys:Double x:Key="DetailFontSizeLarge">22</sys:Double>
		<sys:Double x:Key="BaseFontSize">26</sys:Double>
		<sys:Double x:Key="LargeFontSize">32</sys:Double>
		<sys:Double x:Key="XlFontSize">64</sys:Double>

	</Application.Resources>

	<Application.Styles>
		<materialIcons:MaterialIconStyles />

		<!-- AvaloniaEdit control styles must be registered here for the TextEditor to render. -->
		<StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml" />

		<FluentTheme DensityStyle="Normal">
			<FluentTheme.Palettes>
				<!-- Baseline for the Shop Light preset. ThemeService switches
				     RequestedThemeVariant to Light when a light palette is chosen,
				     then layers the preset's own control colors over this. -->
				<ColorPaletteResources x:Key="Light"
									   Accent="#ff0a6fb8"
									   RegionColor="#ffeff2f6"
									   AltHigh="White" AltLow="White" AltMedium="White"
									   AltMediumHigh="White" AltMediumLow="White"
									   BaseHigh="#ff1a1f27" BaseLow="#ffc2ccd8" BaseMedium="#ff5a6673"
									   BaseMediumHigh="#ff3d4854" BaseMediumLow="#ff8592a1"
									   ChromeAltLow="#ff3d4854" ChromeBlackHigh="Black"
									   ChromeBlackLow="#ffc2ccd8" ChromeBlackMedium="#ff3d4854"
									   ChromeBlackMediumLow="#ff5a6673"
									   ChromeDisabledHigh="#ffc2ccd8" ChromeDisabledLow="#ff8592a1"
									   ChromeGray="#ff6f7c8a" ChromeHigh="#ffc2ccd8"
									   ChromeLow="#ffdfe5ed" ChromeMedium="#ffe4e9f0"
									   ChromeMediumLow="#ffeff2f6" ChromeWhite="White"
									   ListLow="#ffe4e9f0" ListMedium="#ffc2ccd8" />

				<!-- Startup baseline for dark presets, tuned to Classic (the default).
				     ThemeService layers each preset's own control colors over this at
				     runtime; this ramp only has to cover what it does not override
				     (scrollbars, checkbox glyphs, list hover) and avoid a flash of the
				     wrong palette before the saved theme is applied. -->
				<ColorPaletteResources x:Key="Dark"
									   Accent="#ff007acc"
									   RegionColor="#ff282828"
									   AltHigh="#ff2d2d30" AltLow="#ff282828" AltMedium="#ff2d2d30"
									   AltMediumHigh="#ff2d2d30" AltMediumLow="#ff2d2d30"
									   BaseHigh="#ffe8e8e8" BaseLow="#ff3f3f46" BaseMedium="#ffcccccc"
									   BaseMediumHigh="#ffdcdcdc" BaseMediumLow="#ff7c7c7c"
									   ChromeAltLow="#ffdcdcdc" ChromeBlackHigh="#ff141414"
									   ChromeBlackLow="#ffdcdcdc" ChromeBlackMedium="#ff141414"
									   ChromeBlackMediumLow="#ff141414"
									   ChromeDisabledHigh="#ff3f3f46" ChromeDisabledLow="#ff8a8a8a"
									   ChromeGray="#ff929292" ChromeHigh="#ff929292"
									   ChromeLow="#ff252528" ChromeMedium="#ff2d2d30"
									   ChromeMediumLow="#ff3e3e42" ChromeWhite="#ffe8e8e8"
									   ListLow="#ff2d2d30" ListMedium="#ff3f3f46" />
			</FluentTheme.Palettes>
		</FluentTheme>

		<!-- Shared control classes (.panel, .touch, .card, RadioButton.ButtonStyle …).
		     Included after FluentTheme so these win over the base control themes. -->
		<StyleInclude Source="avares://GrbLHALSender/Theming/Controls.axaml" />

	</Application.Styles>
</Application>
