<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:viewModels="clr-namespace:GrbLHALSender.ViewModels"
			 mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
			 x:DataType="viewModels:JobViewModel"
			 x:Class="GrbLHALSender.Views.GcodeOutputView">
	<Design.DataContext>
		<viewModels:JobViewModel/>
	</Design.DataContext>

	<Border HorizontalAlignment="Right" VerticalAlignment="Stretch"
			Background="{StaticResource DarkReduceBrushAlpha}"
			CornerRadius="6" Margin="0,60,5,75"
			MaxWidth="420" MinWidth="350">
		<ListBox x:Name="ListBoxGCode"
				 ItemsSource="{Binding GCodeOutPut}"
				 VerticalAlignment="Stretch"
				 HorizontalAlignment="Stretch"
				 Background="Transparent"
				 Foreground="White"
				 ScrollViewer.VerticalScrollBarVisibility="Auto"
				 FontSize="18">
			<ListBox.Styles>
				<Style Selector="ListBoxItem">
					<Setter Property="Padding" Value="5"/>
				</Style>
			</ListBox.Styles>

			<ListBox.ItemTemplate>
				<DataTemplate>
					<Border Margin="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" 
							Height="35" BorderThickness=".7">
						<StackPanel Orientation="Horizontal">
							<TextBlock Foreground="{StaticResource SystemChromeWhiteColor}" Margin="2,0,5,1"
									   FontWeight="Bold" Opacity="1.0" Text="{Binding LineNumber}" FontSize="18"
									   HorizontalAlignment="Stretch" VerticalAlignment="Center" Width="60" TextAlignment="Center" />

							<TextBlock Foreground="AliceBlue" Margin="2,0,0,1"
									   FontWeight="Bold" Opacity="1.0" Text="{Binding Text}" FontSize="18"
									   HorizontalAlignment="Stretch" VerticalAlignment="Center" TextAlignment="Left" />
						</StackPanel>
					</Border>
				</DataTemplate>
			</ListBox.ItemTemplate>
		</ListBox>
	</Border>
</UserControl>
