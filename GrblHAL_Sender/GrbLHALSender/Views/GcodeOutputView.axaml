<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:viewModels="clr-namespace:GrbLHALSender.ViewModels"
			 xmlns:behaviors="clr-namespace:GrbLHALSender.Behaviors"
			 mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
			 x:DataType="viewModels:JobViewModel"
			 x:Class="GrbLHALSender.Views.GcodeOutputView">
	<Design.DataContext>
		<viewModels:JobViewModel/>
	</Design.DataContext>

	<Border  HorizontalAlignment="Stretch" VerticalAlignment="Stretch" >
		<Grid x:Name="PopOutGcodeGrid"
			  Margin="0,5,0,0"
			  RowDefinitions="*,Auto">

			<ListBox Grid.Row="0" x:Name="ListBoxGCode" Width="400"
					 SelectedIndex="{Binding GcodeFileIndex, Mode=OneWay}"
					 ItemsSource="{Binding GCodeOutPut}"
					 VerticalAlignment="Stretch"
					 HorizontalAlignment="Stretch"
					 Background="{StaticResource DarkReduceBrushAlpha }"
					 Foreground="White"
					 ScrollViewer.VerticalScrollBarVisibility="Auto"
					 IsVisible="{Binding ShowGCodeConsole}"
					 FontSize="18">

				<ListBox.ItemTemplate>
					<DataTemplate>
						<Border Margin="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" BorderBrush="LightGray"
								Height="35" BorderThickness=".7">
							<StackPanel Orientation="Horizontal">
								<TextBlock Foreground="{StaticResource SmokeWhiteText}" Margin="2,0,5,1"
										   FontWeight="Bold" Opacity="1.0"  Text="{Binding LineNumber}" FontSize="18"
										   HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Width="60" TextAlignment="Center" />

								<TextBlock Foreground="AliceBlue" Margin="2,0,0,1"
										   FontWeight="Bold" Opacity="1.0"  Text="{Binding Text}" FontSize="18"
										   HorizontalAlignment="Stretch" VerticalAlignment="Stretch" TextAlignment="Center" />
							</StackPanel>
						</Border>
					</DataTemplate>
				</ListBox.ItemTemplate>
			</ListBox>
			<Button Grid.Row="1"  Height="40" Command="{Binding CloseGCodeConsole}"
					Content="Close"
					VerticalAlignment="Stretch"
					HorizontalAlignment="Stretch"
					FontSize="20"/>
		</Grid>
	</Border>
</UserControl>
